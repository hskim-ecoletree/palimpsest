{
  "agent": "pal-orchestrator",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "Stop"
            ],
            "command": "pal",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "SubagentStop"
            ],
            "command": "pal",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus"
}
