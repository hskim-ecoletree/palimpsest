{
  "agent": "pal-orchestrator",
  "env": {
    "A": "2",
    "Z": "1"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "Stop"
            ],
            "command": "pal",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "SubagentStop"
            ],
            "command": "pal",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Read"
    ]
  }
}
