{"parentUuid":"57aae9f2-da3a-4a9d-bab0-e710d6ed7d8d","isSidechain":true,"promptId":"e3fa886c-8566-423a-8b88-eef66bfd728f","agentId":"a78a7aa16c1e344ac","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pb4NKWM853K6rJ2bpJyjdk","type":"tool_result","content":"1\t\"\"\"표 라이브러리 — CSV 해석과 연산\"\"\"\n2\timport copy\n3\timport json\n4\tfrom typing import Any\n5\t\n6\t\n7\tclass NormError(Exception):\n8\t    \"\"\"표 정규화 오류\"\"\"\n9\t    pass\n10\t\n11\t\n12\tdef _parse_csv_line(line: str, sep: str = \",\") -> list:\n13\t    \"\"\"따옴표를 고려한 CSV 파싱\"\"\"\n14\t    if not line:\n15\t        return []\n16\t\n17\t    result = []\n18\t    current = []\n19\t    in_quotes = False\n20\t    i = 0\n21\t\n22\t    while i < len(line):\n23\t        c = line[i]\n24\t\n25\t        if c == '\"':\n26\t            if in_quotes and i + 1 < len(line) and line[i + 1] == '\"':\n27\t                # \"\" → \"\n28\t                current.append('\"')\n29\t                i += 2\n30\t                continue\n31\t            else:\n32\t                # 따옴표 토글\n33\t                in_quotes = not in_quotes\n34\t                i += 1\n35\t                continue\n36\t\n37\t        if c == sep and not in_quotes:\n38\t            # 필드 구분\n39\t            result.append(''.join(current).strip())\n40\t            current = []\n41\t            i += 1\n42\t            continue\n43\t\n44\t        current.append(c)\n45\t        i += 1\n46\t\n47\t    result.append(''.join(current).strip())\n48\t    return result\n49\t\n50\t\n51\tdef _infer_type(values: list) -> str:\n52\t    \"\"\"값 목록에서 타입 추론\"\"\"\n53\t    has_bool = False\n54\t    has_int = False\n55\t    has_float = False\n56\t    has_str = False\n57\t    has_non_none = False\n58\t\n59\t    for v in values:\n60\t        if v is None:\n61\t            continue\n62\t        has_non_none = True\n63\t        if isinstance(v, str):\n64\t            if not v:\n65\t                continue\n66\t            # 불린 체크 (대소문자 무관)\n67\t            if v.lower() in (\"true\", \"false\"):\n68\t                has_bool = True\n69\t            else:\n70\t                try:\n71\t                    int(v)\n72\t                    has_int = True\n73\t                except ValueError:\n74\t                    try:\n75\t                        float(v)\n76\t                        has_float = True\n77\t                    except ValueError:\n78\t                        has_str = True\n79\t        else:\n80\t            has_str = True\n81\t\n82\t    # 값이 전부 결측이면 \"str\"\n83\t    if not has_non_none:\n84\t        return \"str\"\n85\t\n86\t    if has_str:\n87\t        return \"str\"\n88\t    if has_float:\n89\t        return \"float\"\n90\t    if has_bool:\n91\t        return \"bool\"\n92\t    if has_int:\n93\t        return \"int\"\n94\t    return \"str\"  # 기본값\n95\t\n96\t\n97\tdef _convert_value(v: str, typ: str) -> Any:\n98\t    \"\"\"값을 타입에 맞게 변환\"\"\"\n99\t    if not v or v is None:\n100\t        return None\n101\t\n102\t    if typ == \"bool\":\n103\t        if v.lower() == \"true\":\n104\t            return True\n105\t        elif v.lower() == \"false\":\n106\t            return False\n107\t        return None\n108\t    elif typ == \"int\":\n109\t        try:\n110\t            return int(v)\n111\t        except ValueError:\n112\t            return None\n113\t    elif typ == \"float\":\n114\t        try:\n115\t            return float(v)\n116\t        except ValueError:\n117\t            return None\n118\t    else:  # \"str\"\n119\t        return v\n120\t\n121\t\n122\tdef normalize(text: str, sep: str = \",\") -> dict:\n123\t    \"\"\"CSV 텍스트를 정규화된 표 사전으로\"\"\"\n124\t    if not text or not text.strip():\n125\t        return {\"columns\": [], \"rows\": []}\n126\t\n127\t    lines = text.split('\\n')\n128\t\n129\t    if not lines:\n130\t        return {\"columns\": [], \"rows\": []}\n131\t\n132\t    # 헤더 파싱\n133\t    header_line = lines[0]\n134\t    header_raw = _parse_csv_line(header_line, sep)\n135\t    headers = [h.strip() for h in header_raw]\n136\t\n137\t    # 중복 검사\n138\t    if len(headers) != len(set(headers)):\n139\t        raise NormError(\"입력 헤더에 같은 이름이 둘 이상이다\")\n140\t\n141\t    if not headers:\n142\t        return {\"columns\": [], \"rows\": []}\n143\t\n144\t    # 데이터 행 파싱\n145\t    raw_rows = []\n146\t    for line_no, line in enumerate(lines[1:], 2):\n147\t        # 완전히 빈 줄도 처리해야 함 (빈 셀들의 행)\n148\t        fields = _parse_csv_line(line, sep)\n149\t\n150\t        # 열 개수 검사\n151\t        if len(fields) > len(headers):\n152\t            raise NormError(f\"{line_no}: 열이 헤더보다 많다\")\n153\t\n154\t        # 부족한 열은 None으로 채움\n155\t        while len(fields) < len(headers):\n156\t            fields.append(\"\")\n157\t\n158\t        raw_rows.append(fields)\n159\t\n160\t    # 타입 추론\n161\t    columns_info = []\n162\t    for col_idx, header in enumerate(headers):\n163\t        col_values = [row[col_idx] for row in raw_rows]\n164\t        inferred_type = _infer_type(col_values)\n165\t        columns_info.append({\"name\": header, \"type\": inferred_type})\n166\t\n167\t    # 값 변환\n168\t    converted_rows = []\n169\t    for row in raw_rows:\n170\t        converted_row = []\n171\t        for col_idx, field in enumerate(row):\n172\t            col_type = columns_info[col_idx][\"type\"]\n173\t            converted_row.append(_convert_value(field, col_type))\n174\t        converted_rows.append(converted_row)\n175\t\n176\t    return {\n177\t        \"columns\": columns_info,\n178\t        \"rows\": converted_rows\n179\t    }\n180\t\n181\t\n182\tdef render(table: dict, sep: str = \",\") -> str:\n183\t    \"\"\"표 사전을 CSV 텍스트로\"\"\"\n184\t    if not table[\"columns\"]:\n185\t        return \"\"\n186\t\n187\t    lines = []\n188\t\n189\t    # 헤더\n190\t    header = [col[\"name\"] for col in table[\"columns\"]]\n191\t    header_line = sep.join(_escape_csv_field(h, sep) for h in header)\n192\t    lines.append(header_line)\n193\t\n194\t    # 데이터 행\n195\t    for row in table[\"rows\"]:\n196\t        row_strs = []\n197\t        for v in row:\n198\t            if v is None:\n199\t                row_strs.append(\"\")\n200\t            else:\n201\t                row_strs.append(_escape_csv_field(str(v), sep))\n202\t        lines.append(sep.join(row_strs))\n203\t\n204\t    return '\\n'.join(lines)\n205\t\n206\t\n207\tdef _escape_csv_field(field: str, sep: str = \",\") -> str:\n208\t    \"\"\"CSV 필드 이스케이프\"\"\"\n209\t    if sep in field or '\"' in field or '\\n' in field:\n210\t        # 따옴표 처리\n211\t        escaped = field.replace('\"', '\"\"')\n212\t        return f'\"{escaped}\"'\n213\t    return field\n214\t\n215\t\n216\tdef select(table, names):\n217\t    \"\"\"지정한 열만 선택\"\"\"\n218\t    if not names:\n219\t        return {\"columns\": [], \"rows\": []}\n220\t\n221\t    col_map = {col[\"name\"]: idx for idx, col in enumerate(table[\"columns\"])}\n222\t\n223\t    # 없는 열 검사\n224\t    for name in names:\n225\t        if name not in col_map:\n226\t            raise NormError(f\"없는 열이다: {name}\")\n227\t\n228\t    selected_cols = [table[\"columns\"][col_map[name]] for name in names]\n229\t    selected_indices = [col_map[name] for name in names]\n230\t\n231\t    selected_rows = []\n232\t    for row in table[\"rows\"]:\n233\t        selected_rows.append([row[i] for i in selected_indices])\n234\t\n235\t    return {\n236\t        \"columns\": selected_cols,\n237\t        \"rows\": selected_rows\n238\t    }\n239\t\n240\t\n241\tdef where(table, name, op, value):\n242\t    \"\"\"조건으로 필터링\"\"\"\n243\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n244\t        raise NormError(f\"없는 열이다: {name}\")\n245\t\n246\t    if op not in {\"==\", \"!=\", \"<\", \"<=\", \">\", \">=\"}:\n247\t        raise NormError(f\"모르는 연산자다: {op}\")\n248\t\n249\t    col_idx = None\n250\t    for idx, col in enumerate(table[\"columns\"]):\n251\t        if col[\"name\"] == name:\n252\t            col_idx = idx\n253\t            break\n254\t\n255\t    filtered_rows = []\n256\t    for row in table[\"rows\"]:\n257\t        if row[col_idx] is None:\n258\t            continue\n259\t\n260\t        v = row[col_idx]\n261\t        result = _compare(v, op, value)\n262\t        if result:\n263\t            filtered_rows.append(row)\n264\t\n265\t    return {\n266\t        \"columns\": copy.deepcopy(table[\"columns\"]),\n267\t        \"rows\": filtered_rows\n268\t    }\n269\t\n270\t\n271\tdef _compare(v: Any, op: str, value: Any) -> bool:\n272\t    \"\"\"비교 연산\"\"\"\n273\t    try:\n274\t        if op == \"==\":\n275\t            return v == value\n276\t        elif op == \"!=\":\n277\t            return v != value\n278\t        elif op == \"<\":\n279\t            return v < value\n280\t        elif op == \"<=\":\n281\t            return v <= value\n282\t        elif op == \">\":\n283\t            return v > value\n284\t        elif op == \">=\":\n285\t            return v >= value\n286\t    except TypeError:\n287\t        return False\n288\t    return False\n289\t\n290\t\n291\tdef order_by(table, name, desc=False):\n292\t    \"\"\"정렬\"\"\"\n293\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n294\t        raise NormError(f\"없는 열이다: {name}\")\n295\t\n296\t    col_idx = None\n297\t    for idx, col in enumerate(table[\"columns\"]):\n298\t        if col[\"name\"] == name:\n299\t            col_idx = idx\n300\t            break\n301\t\n302\t    # 결측을 분리\n303\t    with_values = []\n304\t    with_nones = []\n305\t\n306\t    for row in table[\"rows\"]:\n307\t        if row[col_idx] is None:\n308\t            with_nones.append(row)\n309\t        else:\n310\t            with_values.append(row)\n311\t\n312\t    # 정렬\n313\t    with_values.sort(key=lambda r: r[col_idx], reverse=desc)\n314\t\n315\t    # 결측을 맨 뒤에\n316\t    sorted_rows = with_values + with_nones\n317\t\n318\t    return {\n319\t        \"columns\": copy.deepcopy(table[\"columns\"]),\n320\t        \"rows\": sorted_rows\n321\t    }\n322\t\n323\t\n324\tdef agg(table, name, how):\n325\t    \"\"\"집계\"\"\"\n326\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n327\t        raise NormError(f\"없는 열이다: {name}\")\n328\t\n329\t    if how not in {\"sum\", \"mean\", \"min\", \"max\", \"count\"}:\n330\t        raise NormError(f\"알 수 없는 집계다: {how}\")\n331\t\n332\t    col_idx = None\n333\t    for idx, col in enumerate(table[\"columns\"]):\n334\t        if col[\"name\"] == name:\n335\t            col_idx = idx\n336\t            break\n337\t\n338\t    values = [row[col_idx] for row in table[\"rows\"] if row[col_idx] is not None]\n339\t\n340\t    if not values:\n341\t        if how == \"count\":\n342\t            return 0\n343\t        return None\n344\t\n345\t    if how == \"sum\":\n346\t        return sum(values)\n347\t    elif how == \"mean\":\n348\t        return sum(values) / len(values)\n349\t    elif how == \"min\":\n350\t        return min(values)\n351\t    elif how == \"max\":\n352\t        return max(values)\n353\t    elif how == \"count\":\n354\t        return len(values)\n355\t\n356\t\n357\tdef group_count(table, name):\n358\t    \"\"\"값별 개수\"\"\"\n359\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n360\t        raise NormError(f\"없는 열이다: {name}\")\n361\t\n362\t    col_idx = None\n363\t    for idx, col in enumerate(table[\"columns\"]):\n364\t        if col[\"name\"] == name:\n365\t            col_idx = idx\n366\t            break\n367\t\n368\t    counts = {}\n369\t    for row in table[\"rows\"]:\n370\t        v = row[col_idx]\n371\t        # None도 열쇠 하나로\n372\t        if v not in counts:\n373\t            counts[v] = 0\n374\t        counts[v] += 1\n375\t\n376\t    return counts\n377\t\n378\t\n379\tdef rename(table, old, new):\n380\t    \"\"\"열 이름 변경\"\"\"\n381\t    if old not in {col[\"name\"] for col in table[\"columns\"]}:\n382\t        raise NormError(f\"없는 열이다: {old}\")\n383\t\n384\t    if new in {col[\"name\"] for col in table[\"columns\"]} and new != old:\n385\t        raise NormError(f\"이름이 겹친다: {new}\")\n386\t\n387\t    new_cols = []\n388\t    for col in table[\"columns\"]:\n389\t        if col[\"name\"] == old:\n390\t            new_cols.append({\"name\": new, \"type\": col[\"type\"]})\n391\t        else:\n392\t            new_cols.append(col)\n393\t\n394\t    return {\n395\t        \"columns\": new_cols,\n396\t        \"rows\": copy.deepcopy(table[\"rows\"])\n397\t    }\n398\t\n399\t\n400\tdef add_column(table, name, values):\n401\t    \"\"\"열 추가\"\"\"\n402\t    if name in {col[\"name\"] for col in table[\"columns\"]}:\n403\t        raise NormError(f\"이름이 겹친다: {name}\")\n404\t\n405\t    if len(values) != len(table[\"rows\"]):\n406\t        raise NormError(f\"길이가 안 맞는다: {len(values)} != {len(table['rows'])}\")\n407\t\n408\t    new_cols = copy.deepcopy(table[\"columns\"])\n409\t\n410\t    # 타입 추론\n411\t    inferred_type = _infer_type(values)\n412\t    new_cols.append({\"name\": name, \"type\": inferred_type})\n413\t\n414\t    new_rows = []\n415\t    for row, v in zip(table[\"rows\"], values):\n416\t        new_rows.append(row + [v])\n417\t\n418\t    return {\n419\t        \"columns\": new_cols,\n420\t        \"rows\": new_rows\n421\t    }\n422\t\n423\t\n424\tdef to_json(table: dict) -> str:\n425\t    \"\"\"표를 JSON 배열 문자열로\"\"\"\n426\t    rows_as_dicts = []\n427\t    for row in table[\"rows\"]:\n428\t        row_dict = {}\n429\t        for col_idx, col in enumerate(table[\"columns\"]):\n430\t            row_dict[col[\"name\"]] = row[col_idx]\n431\t        rows_as_dicts.append(row_dict)\n432\t\n433\t    return json.dumps(rows_as_dicts, separators=(',', ':'))\n434\t\n435\t\n436\tdef join(a: dict, b: dict, on: str) -> dict:\n437\t    \"\"\"내부 조인\"\"\"\n438\t    # on 열이 양쪽에 있는지 확인\n439\t    a_col_names = {col[\"name\"] for col in a[\"columns\"]}\n440\t    b_col_names = {col[\"name\"] for col in b[\"columns\"]}\n441\t\n442\t    if on not in a_col_names:\n443\t        raise NormError(f\"a에서 없는 열이다: {on}\")\n444\t    if on not in b_col_names:\n445\t        raise NormError(f\"b에서 없는 열이다: {on}\")\n446\t\n447\t    # b의 열 이름 중 on을 제외한 것들\n448\t    b_col_indices = {}\n449\t    b_other_cols = []\n450\t    for idx, col in enumerate(b[\"columns\"]):\n451\t        b_col_indices[col[\"name\"]] = idx\n452\t        if col[\"name\"] != on:\n453\t            b_other_cols.append(col)\n454\t\n455\t    # 결과 열 구성: a의 전부 + b의 on 아닌 것\n456\t    result_columns = copy.deepcopy(a[\"columns\"]) + b_other_cols\n457\t\n458\t    # 열 이름 겹침 검사 (on 제외)\n459\t    a_col_names_set = {col[\"name\"] for col in a[\"columns\"]}\n460\t    for col in b_other_cols:\n461\t        if col[\"name\"] in a_col_names_set:\n462\t            raise NormError(f\"열 이름이 겹친다: {col['name']}\")\n463\t\n464\t    # b의 조인 키별 인덱스 매핑\n465\t    b_on_idx = b_col_indices[on]\n466\t    b_key_map = {}\n467\t    for b_idx, b_row in enumerate(b[\"rows\"]):\n468\t        key = b_row[b_on_idx]\n469\t        if key is not None:  # on이 결측인 행은 무시\n470\t            if key not in b_key_map:\n471\t                b_key_map[key] = []\n472\t            b_key_map[key].append(b_idx)\n473\t\n474\t    # a의 조인 키 인덱스\n475\t    a_on_idx = None\n476\t    for idx, col in enumerate(a[\"columns\"]):\n477\t        if col[\"name\"] == on:\n478\t            a_on_idx = idx\n479\t            break\n480\t\n481\t    # 조인 실행\n482\t    result_rows = []\n483\t    for a_row in a[\"rows\"]:\n484\t        a_key = a_row[a_on_idx]\n485\t        if a_key is not None and a_key in b_key_map:\n486\t            for b_idx in b_key_map[a_key]:\n487\t                b_row = b[\"rows\"][b_idx]\n488\t                # 새로운 행: a의 모든 값 + b의 on 아닌 값들\n489\t                new_row = a_row + [b_row[b_idx] for b_idx, col in enumerate(b[\"columns\"]) if col[\"name\"] != on]\n490\t                result_rows.append(new_row)\n491\t\n492\t    return {\n493\t        \"columns\": result_columns,\n494\t        \"rows\": result_rows\n495\t    }\n496\t"}]},"uuid":"d336ef4c-ab91-4968-8ee2-d4fd5b8c3366","timestamp":"2026-08-23T07:43:51.414Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/pal-x-43/s6/tbl.py","content":"\"\"\"표 라이브러리 — CSV 해석과 연산\"\"\"\nimport copy\nimport json\nfrom typing import Any\n\n\nclass NormError(Exception):\n    \"\"\"표 정규화 오류\"\"\"\n    pass\n\n\ndef _parse_csv_line(line: str, sep: str = \",\") -> list:\n    \"\"\"따옴표를 고려한 CSV 파싱\"\"\"\n    if not line:\n        return []\n\n    result = []\n    current = []\n    in_quotes = False\n    i = 0\n\n    while i < len(line):\n        c = line[i]\n\n        if c == '\"':\n            if in_quotes and i + 1 < len(line) and line[i + 1] == '\"':\n                # \"\" → \"\n                current.append('\"')\n                i += 2\n                continue\n            else:\n                # 따옴표 토글\n                in_quotes = not in_quotes\n                i += 1\n                continue\n\n        if c == sep and not in_quotes:\n            # 필드 구분\n            result.append(''.join(current).strip())\n            current = []\n            i += 1\n            continue\n\n        current.append(c)\n        i += 1\n\n    result.append(''.join(current).strip())\n    return result\n\n\ndef _infer_type(values: list) -> str:\n    \"\"\"값 목록에서 타입 추론\"\"\"\n    has_bool = False\n    has_int = False\n    has_float = False\n    has_str = False\n    has_non_none = False\n\n    for v in values:\n        if v is None:\n            continue\n        has_non_none = True\n        if isinstance(v, str):\n            if not v:\n                continue\n            # 불린 체크 (대소문자 무관)\n            if v.lower() in (\"true\", \"false\"):\n                has_bool = True\n            else:\n                try:\n                    int(v)\n                    has_int = True\n                except ValueError:\n                    try:\n                        float(v)\n                        has_float = True\n                    except ValueError:\n                        has_str = True\n        else:\n            has_str = True\n\n    # 값이 전부 결측이면 \"str\"\n    if not has_non_none:\n        return \"str\"\n\n    if has_str:\n        return \"str\"\n    if has_float:\n        return \"float\"\n    if has_bool:\n        return \"bool\"\n    if has_int:\n        return \"int\"\n    return \"str\"  # 기본값\n\n\ndef _convert_value(v: str, typ: str) -> Any:\n    \"\"\"값을 타입에 맞게 변환\"\"\"\n    if not v or v is None:\n        return None\n\n    if typ == \"bool\":\n        if v.lower() == \"true\":\n            return True\n        elif v.lower() == \"false\":\n            return False\n        return None\n    elif typ == \"int\":\n        try:\n            return int(v)\n        except ValueError:\n            return None\n    elif typ == \"float\":\n        try:\n            return float(v)\n        except ValueError:\n            return None\n    else:  # \"str\"\n        return v\n\n\ndef normalize(text: str, sep: str = \",\") -> dict:\n    \"\"\"CSV 텍스트를 정규화된 표 사전으로\"\"\"\n    if not text or not text.strip():\n        return {\"columns\": [], \"rows\": []}\n\n    lines = text.split('\\n')\n\n    if not lines:\n        return {\"columns\": [], \"rows\": []}\n\n    # 헤더 파싱\n    header_line = lines[0]\n    header_raw = _parse_csv_line(header_line, sep)\n    headers = [h.strip() for h in header_raw]\n\n    # 중복 검사\n    if len(headers) != len(set(headers)):\n        raise NormError(\"입력 헤더에 같은 이름이 둘 이상이다\")\n\n    if not headers:\n        return {\"columns\": [], \"rows\": []}\n\n    # 데이터 행 파싱\n    raw_rows = []\n    for line_no, line in enumerate(lines[1:], 2):\n        # 완전히 빈 줄도 처리해야 함 (빈 셀들의 행)\n        fields = _parse_csv_line(line, sep)\n\n        # 열 개수 검사\n        if len(fields) > len(headers):\n            raise NormError(f\"{line_no}: 열이 헤더보다 많다\")\n\n        # 부족한 열은 None으로 채움\n        while len(fields) < len(headers):\n            fields.append(\"\")\n\n        raw_rows.append(fields)\n\n    # 타입 추론\n    columns_info = []\n    for col_idx, header in enumerate(headers):\n        col_values = [row[col_idx] for row in raw_rows]\n        inferred_type = _infer_type(col_values)\n        columns_info.append({\"name\": header, \"type\": inferred_type})\n\n    # 값 변환\n    converted_rows = []\n    for row in raw_rows:\n        converted_row = []\n        for col_idx, field in enumerate(row):\n            col_type = columns_info[col_idx][\"type\"]\n            converted_row.append(_convert_value(field, col_type))\n        converted_rows.append(converted_row)\n\n    return {\n        \"columns\": columns_info,\n        \"rows\": converted_rows\n    }\n\n\ndef render(table: dict, sep: str = \",\") -> str:\n    \"\"\"표 사전을 CSV 텍스트로\"\"\"\n    if not table[\"columns\"]:\n        return \"\"\n\n    lines = []\n\n    # 헤더\n    header = [col[\"name\"] for col in table[\"columns\"]]\n    header_line = sep.join(_escape_csv_field(h, sep) for h in header)\n    lines.append(header_line)\n\n    # 데이터 행\n    for row in table[\"rows\"]:\n        row_strs = []\n        for v in row:\n            if v is None:\n                row_strs.append(\"\")\n            else:\n                row_strs.append(_escape_csv_field(str(v), sep))\n        lines.append(sep.join(row_strs))\n\n    return '\\n'.join(lines)\n\n\ndef _escape_csv_field(field: str, sep: str = \",\") -> str:\n    \"\"\"CSV 필드 이스케이프\"\"\"\n    if sep in field or '\"' in field or '\\n' in field:\n        # 따옴표 처리\n        escaped = field.replace('\"', '\"\"')\n        return f'\"{escaped}\"'\n    return field\n\n\ndef select(table, names):\n    \"\"\"지정한 열만 선택\"\"\"\n    if not names:\n        return {\"columns\": [], \"rows\": []}\n\n    col_map = {col[\"name\"]: idx for idx, col in enumerate(table[\"columns\"])}\n\n    # 없는 열 검사\n    for name in names:\n        if name not in col_map:\n            raise NormError(f\"없는 열이다: {name}\")\n\n    selected_cols = [table[\"columns\"][col_map[name]] for name in names]\n    selected_indices = [col_map[name] for name in names]\n\n    selected_rows = []\n    for row in table[\"rows\"]:\n        selected_rows.append([row[i] for i in selected_indices])\n\n    return {\n        \"columns\": selected_cols,\n        \"rows\": selected_rows\n    }\n\n\ndef where(table, name, op, value):\n    \"\"\"조건으로 필터링\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    if op not in {\"==\", \"!=\", \"<\", \"<=\", \">\", \">=\"}:\n        raise NormError(f\"모르는 연산자다: {op}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    filtered_rows = []\n    for row in table[\"rows\"]:\n        if row[col_idx] is None:\n            continue\n\n        v = row[col_idx]\n        result = _compare(v, op, value)\n        if result:\n            filtered_rows.append(row)\n\n    return {\n        \"columns\": copy.deepcopy(table[\"columns\"]),\n        \"rows\": filtered_rows\n    }\n\n\ndef _compare(v: Any, op: str, value: Any) -> bool:\n    \"\"\"비교 연산\"\"\"\n    try:\n        if op == \"==\":\n            return v == value\n        elif op == \"!=\":\n            return v != value\n        elif op == \"<\":\n            return v < value\n        elif op == \"<=\":\n            return v <= value\n        elif op == \">\":\n            return v > value\n        elif op == \">=\":\n            return v >= value\n    except TypeError:\n        return False\n    return False\n\n\ndef order_by(table, name, desc=False):\n    \"\"\"정렬\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    # 결측을 분리\n    with_values = []\n    with_nones = []\n\n    for row in table[\"rows\"]:\n        if row[col_idx] is None:\n            with_nones.append(row)\n        else:\n            with_values.append(row)\n\n    # 정렬\n    with_values.sort(key=lambda r: r[col_idx], reverse=desc)\n\n    # 결측을 맨 뒤에\n    sorted_rows = with_values + with_nones\n\n    return {\n        \"columns\": copy.deepcopy(table[\"columns\"]),\n        \"rows\": sorted_rows\n    }\n\n\ndef agg(table, name, how):\n    \"\"\"집계\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    if how not in {\"sum\", \"mean\", \"min\", \"max\", \"count\"}:\n        raise NormError(f\"알 수 없는 집계다: {how}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    values = [row[col_idx] for row in table[\"rows\"] if row[col_idx] is not None]\n\n    if not values:\n        if how == \"count\":\n            return 0\n        return None\n\n    if how == \"sum\":\n        return sum(values)\n    elif how == \"mean\":\n        return sum(values) / len(values)\n    elif how == \"min\":\n        return min(values)\n    elif how == \"max\":\n        return max(values)\n    elif how == \"count\":\n        return len(values)\n\n\ndef group_count(table, name):\n    \"\"\"값별 개수\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    counts = {}\n    for row in table[\"rows\"]:\n        v = row[col_idx]\n        # None도 열쇠 하나로\n        if v not in counts:\n            counts[v] = 0\n        counts[v] += 1\n\n    return counts\n\n\ndef rename(table, old, new):\n    \"\"\"열 이름 변경\"\"\"\n    if old not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {old}\")\n\n    if new in {col[\"name\"] for col in table[\"columns\"]} and new != old:\n        raise NormError(f\"이름이 겹친다: {new}\")\n\n    new_cols = []\n    for col in table[\"columns\"]:\n        if col[\"name\"] == old:\n            new_cols.append({\"name\": new, \"type\": col[\"type\"]})\n        else:\n            new_cols.append(col)\n\n    return {\n        \"columns\": new_cols,\n        \"rows\": copy.deepcopy(table[\"rows\"])\n    }\n\n\ndef add_column(table, name, values):\n    \"\"\"열 추가\"\"\"\n    if name in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"이름이 겹친다: {name}\")\n\n    if len(values) != len(table[\"rows\"]):\n        raise NormError(f\"길이가 안 맞는다: {len(values)} != {len(table['rows'])}\")\n\n    new_cols = copy.deepcopy(table[\"columns\"])\n\n    # 타입 추론\n    inferred_type = _infer_type(values)\n    new_cols.append({\"name\": name, \"type\": inferred_type})\n\n    new_rows = []\n    for row, v in zip(table[\"rows\"], values):\n        new_rows.append(row + [v])\n\n    return {\n        \"columns\": new_cols,\n        \"rows\": new_rows\n    }\n\n\ndef to_json(table: dict) -> str:\n    \"\"\"표를 JSON 배열 문자열로\"\"\"\n    rows_as_dicts = []\n    for row in table[\"rows\"]:\n        row_dict = {}\n        for col_idx, col in enumerate(table[\"columns\"]):\n            row_dict[col[\"name\"]] = row[col_idx]\n        rows_as_dicts.append(row_dict)\n\n    return json.dumps(rows_as_dicts, separators=(',', ':'))\n\n\ndef join(a: dict, b: dict, on: str) -> dict:\n    \"\"\"내부 조인\"\"\"\n    # on 열이 양쪽에 있는지 확인\n    a_col_names = {col[\"name\"] for col in a[\"columns\"]}\n    b_col_names = {col[\"name\"] for col in b[\"columns\"]}\n\n    if on not in a_col_names:\n        raise NormError(f\"a에서 없는 열이다: {on}\")\n    if on not in b_col_names:\n        raise NormError(f\"b에서 없는 열이다: {on}\")\n\n    # b의 열 이름 중 on을 제외한 것들\n    b_col_indices = {}\n    b_other_cols = []\n    for idx, col in enumerate(b[\"columns\"]):\n        b_col_indices[col[\"name\"]] = idx\n        if col[\"name\"] != on:\n            b_other_cols.append(col)\n\n    # 결과 열 구성: a의 전부 + b의 on 아닌 것\n    result_columns = copy.deepcopy(a[\"columns\"]) + b_other_cols\n\n    # 열 이름 겹침 검사 (on 제외)\n    a_col_names_set = {col[\"name\"] for col in a[\"columns\"]}\n    for col in b_other_cols:\n        if col[\"name\"] in a_col_names_set:\n            raise NormError(f\"열 이름이 겹친다: {col['name']}\")\n\n    # b의 조인 키별 인덱스 매핑\n    b_on_idx = b_col_indices[on]\n    b_key_map = {}\n    for b_idx, b_row in enumerate(b[\"rows\"]):\n        key = b_row[b_on_idx]\n        if key is not None:  # on이 결측인 행은 무시\n            if key not in b_key_map:\n                b_key_map[key] = []\n            b_key_map[key].append(b_idx)\n\n    # a의 조인 키 인덱스\n    a_on_idx = None\n    for idx, col in enumerate(a[\"columns\"]):\n        if col[\"name\"] == on:\n            a_on_idx = idx\n            break\n\n    # 조인 실행\n    result_rows = []\n    for a_row in a[\"rows\"]:\n        a_key = a_row[a_on_idx]\n        if a_key is not None and a_key in b_key_map:\n            for b_idx in b_key_map[a_key]:\n                b_row = b[\"rows\"][b_idx]\n                # 새로운 행: a의 모든 값 + b의 on 아닌 값들\n                new_row = a_row + [b_row[b_idx] for b_idx, col in enumerate(b[\"columns\"]) if col[\"name\"] != on]\n                result_rows.append(new_row)\n\n    return {\n        \"columns\": result_columns,\n        \"rows\": result_rows\n    }\n","numLines":496,"startLine":1,"totalLines":496}},"sourceToolAssistantUUID":"57aae9f2-da3a-4a9d-bab0-e710d6ed7d8d","userType":"external","entrypoint":"cli","cwd":"/Users/incognito/dev/projects/palimpsest-agent-laziness/.palimpsest/rounds/2026-08-23-agent-laziness-behavior","sessionId":"34d9dd87-316d-46cf-89ff-ac02b41e62ea","version":"2.1.241","gitBranch":"round/agent-laziness"}
