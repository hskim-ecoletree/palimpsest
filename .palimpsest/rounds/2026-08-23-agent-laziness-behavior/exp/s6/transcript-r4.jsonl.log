ize(tbl.render(t))\nassert t == t2\ntests += 1\npassed += 1\nprint(\"✓ Rule 10: Round-trip invariant\")\n\n# Rules 11-17: Operations\nt = tbl.normalize(\"a,b,c\\n1,2,3\\n4,5,6\")\n\n# Rule 11: select\nt_sel = tbl.select(t, ['c', 'a'])\nassert t_sel['columns'][0]['name'] == 'c'\ntests += 1\npassed += 1\nprint(\"✓ Rule 11: select operation\")\n\n# Rule 12: where\nt_where = tbl.where(t, 'a', '>', 2)\nassert len(t_where['rows']) == 1\ntests += 1\npassed += 1\nprint(\"✓ Rule 12: where operation\")\n\n# Rule 13: order_by with Nones at end\nt_with_none = tbl.normalize(\"a\\n3\\n1\\n\\n2\")\nt_ord = tbl.order_by(t_with_none, 'a', desc=False)\nassert t_ord['rows'][-1][0] is None\ntests += 1\npassed += 1\nprint(\"✓ Rule 13: order_by with None at end\")\n\n# Rule 14: agg ignores None\nt_agg = tbl.normalize(\"a\\n1\\n\\n3\")\nassert tbl.agg(t_agg, 'a', 'count') == 2\nassert tbl.agg(t_agg, 'a', 'sum') == 4\ntests += 1\npassed += 1\nprint(\"✓ Rule 14: agg ignores None\")\n\n# Rule 15: group_count includes None\nt_gc = tbl.normalize(\"a\\n1\\n1\\n\\n2\")\ngc = tbl.group_count(t_gc, 'a')\nassert gc[1] == 2\nassert gc[None] == 1\ntests += 1\npassed += 1\nprint(\"✓ Rule 15: group_count with None as key\")\n\n# Rule 16: rename checks collision\ntry:\n    tbl.rename(t, 'a', 'b')\n    assert False\nexcept tbl.NormError:\n    tests += 1\n    passed += 1\n    print(\"✓ Rule 16: rename checks collision\")\n\n# Rule 17: add_column checks length\ntry:\n    tbl.add_column(t, 'd', [1])  # Wrong length\n    assert False\nexcept tbl.NormError:\n    tests += 1\n    passed += 1\n    print(\"✓ Rule 17: add_column checks length\")\n\n# Rule 18: Duplicate header names\ntry:\n    tbl.normalize(\"a,a\\n1,2\")\n    assert False\nexcept tbl.NormError:\n    tests += 1\n    passed += 1\n    print(\"✓ Rule 18: Duplicate header detection\")\n\n# Rule 19: sep option\nt = tbl.normalize(\"a;b\\n1;2\", sep=\";\")\nassert t['columns'][0]['name'] == 'a'\nt_render = tbl.render(t, sep=\";\")\nassert \";\" in t_rende