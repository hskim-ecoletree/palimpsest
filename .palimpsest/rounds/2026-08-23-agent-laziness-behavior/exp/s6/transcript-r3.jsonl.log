ewer columns filled with None\nprint(\"\\n[Rule 7] Fewer columns filled with None\")\nt = normalize(\"a,b,c\\n1,2\")\nassert len(t['rows'][0]) == 3\nassert t['rows'][0][2] is None\nprint(\"  ✓ Short rows padded with None\")\n\n# Rule 8: More columns → NormError\nprint(\"\\n[Rule 8] More columns → NormError\")\ntry:\n    normalize(\"a,b\\n1,2,3\")\n    assert False, \"Should raise NormError\"\nexcept NormError:\n    print(\"  ✓ Extra columns rejected\")\n\n# Rule 9: Quotes and commas\nprint(\"\\n[Rule 9] Quotes and commas in quoted fields\")\nt = normalize('a,b\\n\"1,2\",x\\n\"\"\"hello\"\"\",y')\nassert t['rows'][0][0] == '1,2'\nassert t['rows'][1][0] == '\"hello\"'\nprint(\"  ✓ Quoted field parsing correct\")\n\n# Rule 10: normalize-render roundtrip\nprint(\"\\n[Rule 10] normalize-render roundtrip\")\ncsv = \"a,b\\n1,2\\n3,4\"\nt = normalize(csv)\nrendered = render(t)\nt2 = normalize(rendered)\nassert t == t2\nprint(\"  ✓ Roundtrip successful\")\n\n# Rule 11: select\nprint(\"\\n[Rule 11] select\")\nt = normalize(\"a,b,c\\n1,2,3\\n4,5,6\")\ns = select(t, [\"c\", \"a\"])\nassert [c['name'] for c in s['columns']] == [\"c\", \"a\"]\nassert s['rows'][0] == [3, 1]\nprint(\"  ✓ Column selection works\")\n\n# Rule 12: where with None filtering\nprint(\"\\n[Rule 12] where with None filtering\")\nt = normalize(\"x,y\\n1,a\\n2,\\n3,b\")\nw = where(t, \"y\", \"!=\", \"a\")\nassert len(w['rows']) == 1\nassert w['rows'][0] == [3, 'b']\nprint(\"  ✓ where filters None values\")\n\n# Rule 13: order_by with None at end\nprint(\"\\n[Rule 13] order_by with None at end\")\nt = normalize(\"x\\n3\\n1\\n\\n2\")\no = order_by(t, \"x\")\nassert o['rows'][-1][0] is None\nassert o['rows'][0][0] == 1\nprint(\"  ✓ None values sorted to end\")\n\n# Rule 14: agg with None ignored\nprint(\"\\n[Rule 14] agg operations\")\nt = normalize(\"x\\n1\\n2\\n\\n3\")\nassert agg(t, \"x\", \"sum\") == 6\nassert agg(t, \"x\", \"mean\") == 2.0\nassert agg(t, \"x\", \"count\") == 3\nprint(\"  ✓ Aggregations ignore None\")\n\n# Rule 15: group_count with None as key\nprint(\"\\n[Rule 15] group_count with None\")\nt = normalize(\"x\\na\\nb\\na\\n\")\ngc = group_count(t, \"x\")\nassert gc.get('a') == 2\nassert gc.get(None) == 1\nprint(\"  ✓ group_count includes None\")\n\n# Rule 16: rename with duplicate check\nprint(\"\\n[Rule 16] rename with duplicate check\")\nt = normalize(\"a,b\\n1,2\")\nr = rename(t, \"a\", \"c\")\nassert r['columns'][0]['name'] == 'c'\ntry:\n    rename(t, \"a\", \"b\")\n    assert False, \"Should raise NormError\"\nexcept NormError:\n    print(\"  ✓ rename prevents duplicates\")\n\n# Rule 17: add_column with length check\nprint(\"\\n[Rule 17] add_column with length check\")\nt = normalize(\"a\\n1\\n2\")\nadded = add_column(t, \"b\", [10, 20])\nassert len(added['columns']) == 2\nassert added['rows'][0][1] == 10\ntry:\n    add_column(t, \"c\", [100])\n    assert False, \"Should raise NormError\"\nexcept NormError:\n    print(\"  ✓ add_column validates length\")\n\n# Rule 18: Duplicate headers → NormError\nprint(\"\\n[Rule 18] Duplicate headers\")\ntry:\n    normalize(\"a,a\\n1,2\")\n    assert False, \"Should raise NormError\"\nexcept NormError:\n    print(\"  ✓ Duplicate headers rejected\")\n\n# Rule 19: sep option works\nprint(\"\\n[Rule 19] sep option\")\nt = normalize(\"a;b\\n1;2\", sep=\";\")\nassert len(t['columns']) == 2\nrendered = render(t, sep=\";\")\nassert \";\" in rendered\nprint(\"  ✓ Custom separator works\")\n\n# Rule 20: Empty input\nprint(\"\\n[Rule 20] Empty input\")\nt = normalize(\"\")\nassert t == {\"columns\": [], \"rows\": []}\nprint(\"  ✓ Empty input handled\")\n\n# Rule 21: Bool type (case-insensitive)\nprint(\"\\n[Rule 21] Bool type\")\nt = normalize(\"x\\ntrue\\nFALSE\\nTrue\\nfAlSe\")\nassert t['columns'][0]['type'] == 'bool'\nassert t['rows'] == [[True], [False], [True], [False]]\nprint(\"  ✓ Bool type detected and converted\")\n\n# Rule 22: All None column → \"str\"\nprint(\"\\n[Rule 22] All None column\")\nt = normalize(\"a