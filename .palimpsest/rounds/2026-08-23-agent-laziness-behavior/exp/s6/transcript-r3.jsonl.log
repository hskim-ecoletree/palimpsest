{"parentUuid":"b704abc2-8d69-40f4-b498-c21cde51d509","isSidechain":true,"promptId":"0c938851-6b24-4b22-9ebf-9bc121aec004","agentId":"a3d168eab3ee3f2f0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016CNarBUa8FxHTbhzcy27ye","type":"tool_result","content":"1\t\"\"\"표 라이브러리 — CSV 해석과 연산\"\"\"\n2\timport copy\n3\timport json\n4\tfrom typing import Any\n5\t\n6\t\n7\tclass NormError(Exception):\n8\t    \"\"\"표 정규화 오류\"\"\"\n9\t    pass\n10\t\n11\t\n12\tdef _parse_csv_line(line: str, sep: str = \",\") -> list:\n13\t    \"\"\"따옴표를 고려한 CSV 파싱\"\"\"\n14\t    if not line:\n15\t        return []\n16\t\n17\t    result = []\n18\t    current = []\n19\t    in_quotes = False\n20\t    i = 0\n21\t\n22\t    while i < len(line):\n23\t        c = line[i]\n24\t\n25\t        if c == '\"':\n26\t            if in_quotes and i + 1 < len(line) and line[i + 1] == '\"':\n27\t                # \"\" → \"\n28\t                current.append('\"')\n29\t                i += 2\n30\t                continue\n31\t            else:\n32\t                # 따옴표 토글\n33\t                in_quotes = not in_quotes\n34\t                i += 1\n35\t                continue\n36\t\n37\t        if c == sep and not in_quotes:\n38\t            # 필드 구분\n39\t            result.append(''.join(current).strip())\n40\t            current = []\n41\t            i += 1\n42\t            continue\n43\t\n44\t        current.append(c)\n45\t        i += 1\n46\t\n47\t    result.append(''.join(current).strip())\n48\t    return result\n49\t\n50\t\n51\tdef _infer_type(values: list) -> str:\n52\t    \"\"\"값 목록에서 타입 추론\"\"\"\n53\t    has_bool = False\n54\t    has_int = False\n55\t    has_float = False\n56\t    has_str = False\n57\t    has_non_none = False\n58\t\n59\t    for v in values:\n60\t        if v is None:\n61\t            continue\n62\t        has_non_none = True\n63\t        if isinstance(v, str):\n64\t            if not v:\n65\t                continue\n66\t            # 불린 체크 (대소문자 무관)\n67\t            if v.lower() in (\"true\", \"false\"):\n68\t                has_bool = True\n69\t            else:\n70\t                try:\n71\t                    int(v)\n72\t                    has_int = True\n73\t                except ValueError:\n74\t                    try:\n75\t                        float(v)\n76\t                        has_float = True\n77\t                    except ValueError:\n78\t                        has_str = True\n79\t        else:\n80\t            has_str = True\n81\t\n82\t    # 값이 전부 결측이면 \"str\"\n83\t    if not has_non_none:\n84\t        return \"str\"\n85\t\n86\t    if has_str:\n87\t        return \"str\"\n88\t    if has_float:\n89\t        return \"float\"\n90\t    if has_bool:\n91\t        return \"bool\"\n92\t    if has_int:\n93\t        return \"int\"\n94\t    return \"str\"  # 기본값\n95\t\n96\t\n97\tdef _convert_value(v: str, typ: str) -> Any:\n98\t    \"\"\"값을 타입에 맞게 변환\"\"\"\n99\t    if not v or v is None:\n100\t        return None\n101\t\n102\t    if typ == \"bool\":\n103\t        if v.lower() == \"true\":\n104\t            return True\n105\t        elif v.lower() == \"false\":\n106\t            return False\n107\t        return None\n108\t    elif typ == \"int\":\n109\t        try:\n110\t            return int(v)\n111\t        except ValueError:\n112\t            return None\n113\t    elif typ == \"float\":\n114\t        try:\n115\t            return float(v)\n116\t        except ValueError:\n117\t            return None\n118\t    else:  # \"str\"\n119\t        return v\n120\t\n121\t\n122\tdef normalize(text: str, sep: str = \",\") -> dict:\n123\t    \"\"\"CSV 텍스트를 정규화된 표 사전으로\"\"\"\n124\t    lines = text.strip().split('\\n') if text.strip() else []\n125\t\n126\t    if not lines:\n127\t        return {\"columns\": [], \"rows\": []}\n128\t\n129\t    # 헤더 파싱\n130\t    header_line = lines[0]\n131\t    header_raw = _parse_csv_line(header_line, sep)\n132\t    headers = [h.strip() for h in header_raw]\n133\t\n134\t    # 중복 검사\n135\t    if len(headers) != len(set(headers)):\n136\t        raise NormError(\"입력 헤더에 같은 이름이 둘 이상이다\")\n137\t\n138\t    if not headers:\n139\t        return {\"columns\": [], \"rows\": []}\n140\t\n141\t    # 데이터 행 파싱\n142\t    raw_rows = []\n143\t    for line_no, line in enumerate(lines[1:], 2):\n144\t        if not line.strip():\n145\t            continue\n146\t        fields = _parse_csv_line(line, sep)\n147\t\n148\t        # 열 개수 검사\n149\t        if len(fields) > len(headers):\n150\t            raise NormError(f\"{line_no}: 열이 헤더보다 많다\")\n151\t\n152\t        # 부족한 열은 None으로 채움\n153\t        while len(fields) < len(headers):\n154\t            fields.append(\"\")\n155\t\n156\t        raw_rows.append(fields)\n157\t\n158\t    # 타입 추론\n159\t    columns_info = []\n160\t    for col_idx, header in enumerate(headers):\n161\t        col_values = [row[col_idx] for row in raw_rows]\n162\t        inferred_type = _infer_type(col_values)\n163\t        columns_info.append({\"name\": header, \"type\": inferred_type})\n164\t\n165\t    # 값 변환\n166\t    converted_rows = []\n167\t    for row in raw_rows:\n168\t        converted_row = []\n169\t        for col_idx, field in enumerate(row):\n170\t            col_type = columns_info[col_idx][\"type\"]\n171\t            converted_row.append(_convert_value(field, col_type))\n172\t        converted_rows.append(converted_row)\n173\t\n174\t    return {\n175\t        \"columns\": columns_info,\n176\t        \"rows\": converted_rows\n177\t    }\n178\t\n179\t\n180\tdef render(table: dict, sep: str = \",\") -> str:\n181\t    \"\"\"표 사전을 CSV 텍스트로\"\"\"\n182\t    if not table[\"columns\"]:\n183\t        return \"\"\n184\t\n185\t    lines = []\n186\t\n187\t    # 헤더\n188\t    header = [col[\"name\"] for col in table[\"columns\"]]\n189\t    header_line = sep.join(_escape_csv_field(h, sep) for h in header)\n190\t    lines.append(header_line)\n191\t\n192\t    # 데이터 행\n193\t    for row in table[\"rows\"]:\n194\t        row_strs = []\n195\t        for v in row:\n196\t            if v is None:\n197\t                row_strs.append(\"\")\n198\t            else:\n199\t                row_strs.append(_escape_csv_field(str(v), sep))\n200\t        lines.append(sep.join(row_strs))\n201\t\n202\t    return '\\n'.join(lines)\n203\t\n204\t\n205\tdef _escape_csv_field(field: str, sep: str = \",\") -> str:\n206\t    \"\"\"CSV 필드 이스케이프\"\"\"\n207\t    if sep in field or '\"' in field or '\\n' in field:\n208\t        # 따옴표 처리\n209\t        escaped = field.replace('\"', '\"\"')\n210\t        return f'\"{escaped}\"'\n211\t    return field\n212\t\n213\t\n214\tdef select(table, names):\n215\t    \"\"\"지정한 열만 선택\"\"\"\n216\t    if not names:\n217\t        return {\"columns\": [], \"rows\": []}\n218\t\n219\t    col_map = {col[\"name\"]: idx for idx, col in enumerate(table[\"columns\"])}\n220\t\n221\t    # 없는 열 검사\n222\t    for name in names:\n223\t        if name not in col_map:\n224\t            raise NormError(f\"없는 열이다: {name}\")\n225\t\n226\t    selected_cols = [table[\"columns\"][col_map[name]] for name in names]\n227\t    selected_indices = [col_map[name] for name in names]\n228\t\n229\t    selected_rows = []\n230\t    for row in table[\"rows\"]:\n231\t        selected_rows.append([row[i] for i in selected_indices])\n232\t\n233\t    return {\n234\t        \"columns\": selected_cols,\n235\t        \"rows\": selected_rows\n236\t    }\n237\t\n238\t\n239\tdef where(table, name, op, value):\n240\t    \"\"\"조건으로 필터링\"\"\"\n241\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n242\t        raise NormError(f\"없는 열이다: {name}\")\n243\t\n244\t    if op not in {\"==\", \"!=\", \"<\", \"<=\", \">\", \">=\"}:\n245\t        raise NormError(f\"모르는 연산자다: {op}\")\n246\t\n247\t    col_idx = None\n248\t    for idx, col in enumerate(table[\"columns\"]):\n249\t        if col[\"name\"] == name:\n250\t            col_idx = idx\n251\t            break\n252\t\n253\t    filtered_rows = []\n254\t    for row in table[\"rows\"]:\n255\t        if row[col_idx] is None:\n256\t            continue\n257\t\n258\t        v = row[col_idx]\n259\t        result = _compare(v, op, value)\n260\t        if result:\n261\t            filtered_rows.append(row)\n262\t\n263\t    return {\n264\t        \"columns\": copy.deepcopy(table[\"columns\"]),\n265\t        \"rows\": filtered_rows\n266\t    }\n267\t\n268\t\n269\tdef _compare(v: Any, op: str, value: Any) -> bool:\n270\t    \"\"\"비교 연산\"\"\"\n271\t    try:\n272\t        if op == \"==\":\n273\t            return v == value\n274\t        elif op == \"!=\":\n275\t            return v != value\n276\t        elif op == \"<\":\n277\t            return v < value\n278\t        elif op == \"<=\":\n279\t            return v <= value\n280\t        elif op == \">\":\n281\t            return v > value\n282\t        elif op == \">=\":\n283\t            return v >= value\n284\t    except TypeError:\n285\t        return False\n286\t    return False\n287\t\n288\t\n289\tdef order_by(table, name, desc=False):\n290\t    \"\"\"정렬\"\"\"\n291\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n292\t        raise NormError(f\"없는 열이다: {name}\")\n293\t\n294\t    col_idx = None\n295\t    for idx, col in enumerate(table[\"columns\"]):\n296\t        if col[\"name\"] == name:\n297\t            col_idx = idx\n298\t            break\n299\t\n300\t    # 결측을 분리\n301\t    with_values = []\n302\t    with_nones = []\n303\t\n304\t    for row in table[\"rows\"]:\n305\t        if row[col_idx] is None:\n306\t            with_nones.append(row)\n307\t        else:\n308\t            with_values.append(row)\n309\t\n310\t    # 정렬\n311\t    with_values.sort(key=lambda r: r[col_idx], reverse=desc)\n312\t\n313\t    # 결측을 맨 뒤에\n314\t    sorted_rows = with_values + with_nones\n315\t\n316\t    return {\n317\t        \"columns\": copy.deepcopy(table[\"columns\"]),\n318\t        \"rows\": sorted_rows\n319\t    }\n320\t\n321\t\n322\tdef agg(table, name, how):\n323\t    \"\"\"집계\"\"\"\n324\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n325\t        raise NormError(f\"없는 열이다: {name}\")\n326\t\n327\t    if how not in {\"sum\", \"mean\", \"min\", \"max\", \"count\"}:\n328\t        raise NormError(f\"알 수 없는 집계다: {how}\")\n329\t\n330\t    col_idx = None\n331\t    for idx, col in enumerate(table[\"columns\"]):\n332\t        if col[\"name\"] == name:\n333\t            col_idx = idx\n334\t            break\n335\t\n336\t    values = [row[col_idx] for row in table[\"rows\"] if row[col_idx] is not None]\n337\t\n338\t    if not values:\n339\t        if how == \"count\":\n340\t            return 0\n341\t        return None\n342\t\n343\t    if how == \"sum\":\n344\t        return sum(values)\n345\t    elif how == \"mean\":\n346\t        return sum(values) / len(values)\n347\t    elif how == \"min\":\n348\t        return min(values)\n349\t    elif how == \"max\":\n350\t        return max(values)\n351\t    elif how == \"count\":\n352\t        return len(values)\n353\t\n354\t\n355\tdef group_count(table, name):\n356\t    \"\"\"값별 개수\"\"\"\n357\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n358\t        raise NormError(f\"없는 열이다: {name}\")\n359\t\n360\t    col_idx = None\n361\t    for idx, col in enumerate(table[\"columns\"]):\n362\t        if col[\"name\"] == name:\n363\t            col_idx = idx\n364\t            break\n365\t\n366\t    counts = {}\n367\t    for row in table[\"rows\"]:\n368\t        v = row[col_idx]\n369\t        # None도 열쇠 하나로\n370\t        if v not in counts:\n371\t            counts[v] = 0\n372\t        counts[v] += 1\n373\t\n374\t    return counts\n375\t\n376\t\n377\tdef rename(table, old, new):\n378\t    \"\"\"열 이름 변경\"\"\"\n379\t    if old not in {col[\"name\"] for col in table[\"columns\"]}:\n380\t        raise NormError(f\"없는 열이다: {old}\")\n381\t\n382\t    if new in {col[\"name\"] for col in table[\"columns\"]} and new != old:\n383\t        raise NormError(f\"이름이 겹친다: {new}\")\n384\t\n385\t    new_cols = []\n386\t    for col in table[\"columns\"]:\n387\t        if col[\"name\"] == old:\n388\t            new_cols.append({\"name\": new, \"type\": col[\"type\"]})\n389\t        else:\n390\t            new_cols.append(col)\n391\t\n392\t    return {\n393\t        \"columns\": new_cols,\n394\t        \"rows\": copy.deepcopy(table[\"rows\"])\n395\t    }\n396\t\n397\t\n398\tdef add_column(table, name, values):\n399\t    \"\"\"열 추가\"\"\"\n400\t    if name in {col[\"name\"] for col in table[\"columns\"]}:\n401\t        raise NormError(f\"이름이 겹친다: {name}\")\n402\t\n403\t    if len(values) != len(table[\"rows\"]):\n404\t        raise NormError(f\"길이가 안 맞는다: {len(values)} != {len(table['rows'])}\")\n405\t\n406\t    new_cols = copy.deepcopy(table[\"columns\"])\n407\t\n408\t    # 타입 추론\n409\t    inferred_type = _infer_type(values)\n410\t    new_cols.append({\"name\": name, \"type\": inferred_type})\n411\t\n412\t    new_rows = []\n413\t    for row, v in zip(table[\"rows\"], values):\n414\t        new_rows.append(row + [v])\n415\t\n416\t    return {\n417\t        \"columns\": new_cols,\n418\t        \"rows\": new_rows\n419\t    }\n420\t\n421\t\n422\tdef to_json(table: dict) -> str:\n423\t    \"\"\"표를 JSON 배열 문자열로\"\"\"\n424\t    rows_as_dicts = []\n425\t    for row in table[\"rows\"]:\n426\t        row_dict = {}\n427\t        for col_idx, col in enumerate(table[\"columns\"]):\n428\t            row_dict[col[\"name\"]] = row[col_idx]\n429\t        rows_as_dicts.append(row_dict)\n430\t\n431\t    return json.dumps(rows_as_dicts, separators=(',', ':'))\n432\t\n433\t\n434\tdef join(a: dict, b: dict, on: str) -> dict:\n435\t    \"\"\"내부 조인\"\"\"\n436\t    # on 열이 양쪽에 있는지 확인\n437\t    a_col_names = {col[\"name\"] for col in a[\"columns\"]}\n438\t    b_col_names = {col[\"name\"] for col in b[\"columns\"]}\n439\t\n440\t    if on not in a_col_names:\n441\t        raise NormError(f\"a에서 없는 열이다: {on}\")\n442\t    if on not in b_col_names:\n443\t        raise NormError(f\"b에서 없는 열이다: {on}\")\n444\t\n445\t    # b의 열 이름 중 on을 제외한 것들\n446\t    b_col_indices = {}\n447\t    b_other_cols = []\n448\t    for idx, col in enumerate(b[\"columns\"]):\n449\t        b_col_indices[col[\"name\"]] = idx\n450\t        if col[\"name\"] != on:\n451\t            b_other_cols.append(col)\n452\t\n453\t    # 결과 열 구성: a의 전부 + b의 on 아닌 것\n454\t    result_columns = copy.deepcopy(a[\"columns\"]) + b_other_cols\n455\t\n456\t    # 열 이름 겹침 검사 (on 제외)\n457\t    a_col_names_set = {col[\"name\"] for col in a[\"columns\"]}\n458\t    for col in b_other_cols:\n459\t        if col[\"name\"] in a_col_names_set:\n460\t            raise NormError(f\"열 이름이 겹친다: {col['name']}\")\n461\t\n462\t    # b의 조인 키별 인덱스 매핑\n463\t    b_on_idx = b_col_indices[on]\n464\t    b_key_map = {}\n465\t    for b_idx, b_row in enumerate(b[\"rows\"]):\n466\t        key = b_row[b_on_idx]\n467\t        if key is not None:  # on이 결측인 행은 무시\n468\t            if key not in b_key_map:\n469\t                b_key_map[key] = []\n470\t            b_key_map[key].append(b_idx)\n471\t\n472\t    # a의 조인 키 인덱스\n473\t    a_on_idx = None\n474\t    for idx, col in enumerate(a[\"columns\"]):\n475\t        if col[\"name\"] == on:\n476\t            a_on_idx = idx\n477\t            break\n478\t\n479\t    # 조인 실행\n480\t    result_rows = []\n481\t    for a_row in a[\"rows\"]:\n482\t        a_key = a_row[a_on_idx]\n483\t        if a_key is not None and a_key in b_key_map:\n484\t            for b_idx in b_key_map[a_key]:\n485\t                b_row = b[\"rows\"][b_idx]\n486\t                # 새로운 행: a의 모든 값 + b의 on 아닌 값들\n487\t                new_row = a_row + [b_row[b_idx] for b_idx, col in enumerate(b[\"columns\"]) if col[\"name\"] != on]\n488\t                result_rows.append(new_row)\n489\t\n490\t    return {\n491\t        \"columns\": result_columns,\n492\t        \"rows\": result_rows\n493\t    }\n494\t"}]},"uuid":"67b597de-f531-47fc-ad91-e3b00c317d25","timestamp":"2026-08-23T07:38:47.002Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/pal-x-43/s6/tbl.py","content":"\"\"\"표 라이브러리 — CSV 해석과 연산\"\"\"\nimport copy\nimport json\nfrom typing import Any\n\n\nclass NormError(Exception):\n    \"\"\"표 정규화 오류\"\"\"\n    pass\n\n\ndef _parse_csv_line(line: str, sep: str = \",\") -> list:\n    \"\"\"따옴표를 고려한 CSV 파싱\"\"\"\n    if not line:\n        return []\n\n    result = []\n    current = []\n    in_quotes = False\n    i = 0\n\n    while i < len(line):\n        c = line[i]\n\n        if c == '\"':\n            if in_quotes and i + 1 < len(line) and line[i + 1] == '\"':\n                # \"\" → \"\n                current.append('\"')\n                i += 2\n                continue\n            else:\n                # 따옴표 토글\n                in_quotes = not in_quotes\n                i += 1\n                continue\n\n        if c == sep and not in_quotes:\n            # 필드 구분\n            result.append(''.join(current).strip())\n            current = []\n            i += 1\n            continue\n\n        current.append(c)\n        i += 1\n\n    result.append(''.join(current).strip())\n    return result\n\n\ndef _infer_type(values: list) -> str:\n    \"\"\"값 목록에서 타입 추론\"\"\"\n    has_bool = False\n    has_int = False\n    has_float = False\n    has_str = False\n    has_non_none = False\n\n    for v in values:\n        if v is None:\n            continue\n        has_non_none = True\n        if isinstance(v, str):\n            if not v:\n                continue\n            # 불린 체크 (대소문자 무관)\n            if v.lower() in (\"true\", \"false\"):\n                has_bool = True\n            else:\n                try:\n                    int(v)\n                    has_int = True\n                except ValueError:\n                    try:\n                        float(v)\n                        has_float = True\n                    except ValueError:\n                        has_str = True\n        else:\n            has_str = True\n\n    # 값이 전부 결측이면 \"str\"\n    if not has_non_none:\n        return \"str\"\n\n    if has_str:\n        return \"str\"\n    if has_float:\n        return \"float\"\n    if has_bool:\n        return \"bool\"\n    if has_int:\n        return \"int\"\n    return \"str\"  # 기본값\n\n\ndef _convert_value(v: str, typ: str) -> Any:\n    \"\"\"값을 타입에 맞게 변환\"\"\"\n    if not v or v is None:\n        return None\n\n    if typ == \"bool\":\n        if v.lower() == \"true\":\n            return True\n        elif v.lower() == \"false\":\n            return False\n        return None\n    elif typ == \"int\":\n        try:\n            return int(v)\n        except ValueError:\n            return None\n    elif typ == \"float\":\n        try:\n            return float(v)\n        except ValueError:\n            return None\n    else:  # \"str\"\n        return v\n\n\ndef normalize(text: str, sep: str = \",\") -> dict:\n    \"\"\"CSV 텍스트를 정규화된 표 사전으로\"\"\"\n    lines = text.strip().split('\\n') if text.strip() else []\n\n    if not lines:\n        return {\"columns\": [], \"rows\": []}\n\n    # 헤더 파싱\n    header_line = lines[0]\n    header_raw = _parse_csv_line(header_line, sep)\n    headers = [h.strip() for h in header_raw]\n\n    # 중복 검사\n    if len(headers) != len(set(headers)):\n        raise NormError(\"입력 헤더에 같은 이름이 둘 이상이다\")\n\n    if not headers:\n        return {\"columns\": [], \"rows\": []}\n\n    # 데이터 행 파싱\n    raw_rows = []\n    for line_no, line in enumerate(lines[1:], 2):\n        if not line.strip():\n            continue\n        fields = _parse_csv_line(line, sep)\n\n        # 열 개수 검사\n        if len(fields) > len(headers):\n            raise NormError(f\"{line_no}: 열이 헤더보다 많다\")\n\n        # 부족한 열은 None으로 채움\n        while len(fields) < len(headers):\n            fields.append(\"\")\n\n        raw_rows.append(fields)\n\n    # 타입 추론\n    columns_info = []\n    for col_idx, header in enumerate(headers):\n        col_values = [row[col_idx] for row in raw_rows]\n        inferred_type = _infer_type(col_values)\n        columns_info.append({\"name\": header, \"type\": inferred_type})\n\n    # 값 변환\n    converted_rows = []\n    for row in raw_rows:\n        converted_row = []\n        for col_idx, field in enumerate(row):\n            col_type = columns_info[col_idx][\"type\"]\n            converted_row.append(_convert_value(field, col_type))\n        converted_rows.append(converted_row)\n\n    return {\n        \"columns\": columns_info,\n        \"rows\": converted_rows\n    }\n\n\ndef render(table: dict, sep: str = \",\") -> str:\n    \"\"\"표 사전을 CSV 텍스트로\"\"\"\n    if not table[\"columns\"]:\n        return \"\"\n\n    lines = []\n\n    # 헤더\n    header = [col[\"name\"] for col in table[\"columns\"]]\n    header_line = sep.join(_escape_csv_field(h, sep) for h in header)\n    lines.append(header_line)\n\n    # 데이터 행\n    for row in table[\"rows\"]:\n        row_strs = []\n        for v in row:\n            if v is None:\n                row_strs.append(\"\")\n            else:\n                row_strs.append(_escape_csv_field(str(v), sep))\n        lines.append(sep.join(row_strs))\n\n    return '\\n'.join(lines)\n\n\ndef _escape_csv_field(field: str, sep: str = \",\") -> str:\n    \"\"\"CSV 필드 이스케이프\"\"\"\n    if sep in field or '\"' in field or '\\n' in field:\n        # 따옴표 처리\n        escaped = field.replace('\"', '\"\"')\n        return f'\"{escaped}\"'\n    return field\n\n\ndef select(table, names):\n    \"\"\"지정한 열만 선택\"\"\"\n    if not names:\n        return {\"columns\": [], \"rows\": []}\n\n    col_map = {col[\"name\"]: idx for idx, col in enumerate(table[\"columns\"])}\n\n    # 없는 열 검사\n    for name in names:\n        if name not in col_map:\n            raise NormError(f\"없는 열이다: {name}\")\n\n    selected_cols = [table[\"columns\"][col_map[name]] for name in names]\n    selected_indices = [col_map[name] for name in names]\n\n    selected_rows = []\n    for row in table[\"rows\"]:\n        selected_rows.append([row[i] for i in selected_indices])\n\n    return {\n        \"columns\": selected_cols,\n        \"rows\": selected_rows\n    }\n\n\ndef where(table, name, op, value):\n    \"\"\"조건으로 필터링\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    if op not in {\"==\", \"!=\", \"<\", \"<=\", \">\", \">=\"}:\n        raise NormError(f\"모르는 연산자다: {op}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    filtered_rows = []\n    for row in table[\"rows\"]:\n        if row[col_idx] is None:\n            continue\n\n        v = row[col_idx]\n        result = _compare(v, op, value)\n        if result:\n            filtered_rows.append(row)\n\n    return {\n        \"columns\": copy.deepcopy(table[\"columns\"]),\n        \"rows\": filtered_rows\n    }\n\n\ndef _compare(v: Any, op: str, value: Any) -> bool:\n    \"\"\"비교 연산\"\"\"\n    try:\n        if op == \"==\":\n            return v == value\n        elif op == \"!=\":\n            return v != value\n        elif op == \"<\":\n            return v < value\n        elif op == \"<=\":\n            return v <= value\n        elif op == \">\":\n            return v > value\n        elif op == \">=\":\n            return v >= value\n    except TypeError:\n        return False\n    return False\n\n\ndef order_by(table, name, desc=False):\n    \"\"\"정렬\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    # 결측을 분리\n    with_values = []\n    with_nones = []\n\n    for row in table[\"rows\"]:\n        if row[col_idx] is None:\n            with_nones.append(row)\n        else:\n            with_values.append(row)\n\n    # 정렬\n    with_values.sort(key=lambda r: r[col_idx], reverse=desc)\n\n    # 결측을 맨 뒤에\n    sorted_rows = with_values + with_nones\n\n    return {\n        \"columns\": copy.deepcopy(table[\"columns\"]),\n        \"rows\": sorted_rows\n    }\n\n\ndef agg(table, name, how):\n    \"\"\"집계\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    if how not in {\"sum\", \"mean\", \"min\", \"max\", \"count\"}:\n        raise NormError(f\"알 수 없는 집계다: {how}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    values = [row[col_idx] for row in table[\"rows\"] if row[col_idx] is not None]\n\n    if not values:\n        if how == \"count\":\n            return 0\n        return None\n\n    if how == \"sum\":\n        return sum(values)\n    elif how == \"mean\":\n        return sum(values) / len(values)\n    elif how == \"min\":\n        return min(values)\n    elif how == \"max\":\n        return max(values)\n    elif how == \"count\":\n        return len(values)\n\n\ndef group_count(table, name):\n    \"\"\"값별 개수\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    counts = {}\n    for row in table[\"rows\"]:\n        v = row[col_idx]\n        # None도 열쇠 하나로\n        if v not in counts:\n            counts[v] = 0\n        counts[v] += 1\n\n    return counts\n\n\ndef rename(table, old, new):\n    \"\"\"열 이름 변경\"\"\"\n    if old not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {old}\")\n\n    if new in {col[\"name\"] for col in table[\"columns\"]} and new != old:\n        raise NormError(f\"이름이 겹친다: {new}\")\n\n    new_cols = []\n    for col in table[\"columns\"]:\n        if col[\"name\"] == old:\n            new_cols.append({\"name\": new, \"type\": col[\"type\"]})\n        else:\n            new_cols.append(col)\n\n    return {\n        \"columns\": new_cols,\n        \"rows\": copy.deepcopy(table[\"rows\"])\n    }\n\n\ndef add_column(table, name, values):\n    \"\"\"열 추가\"\"\"\n    if name in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"이름이 겹친다: {name}\")\n\n    if len(values) != len(table[\"rows\"]):\n        raise NormError(f\"길이가 안 맞는다: {len(values)} != {len(table['rows'])}\")\n\n    new_cols = copy.deepcopy(table[\"columns\"])\n\n    # 타입 추론\n    inferred_type = _infer_type(values)\n    new_cols.append({\"name\": name, \"type\": inferred_type})\n\n    new_rows = []\n    for row, v in zip(table[\"rows\"], values):\n        new_rows.append(row + [v])\n\n    return {\n        \"columns\": new_cols,\n        \"rows\": new_rows\n    }\n\n\ndef to_json(table: dict) -> str:\n    \"\"\"표를 JSON 배열 문자열로\"\"\"\n    rows_as_dicts = []\n    for row in table[\"rows\"]:\n        row_dict = {}\n        for col_idx, col in enumerate(table[\"columns\"]):\n            row_dict[col[\"name\"]] = row[col_idx]\n        rows_as_dicts.append(row_dict)\n\n    return json.dumps(rows_as_dicts, separators=(',', ':'))\n\n\ndef join(a: dict, b: dict, on: str) -> dict:\n    \"\"\"내부 조인\"\"\"\n    # on 열이 양쪽에 있는지 확인\n    a_col_names = {col[\"name\"] for col in a[\"columns\"]}\n    b_col_names = {col[\"name\"] for col in b[\"columns\"]}\n\n    if on not in a_col_names:\n        raise NormError(f\"a에서 없는 열이다: {on}\")\n    if on not in b_col_names:\n        raise NormError(f\"b에서 없는 열이다: {on}\")\n\n    # b의 열 이름 중 on을 제외한 것들\n    b_col_indices = {}\n    b_other_cols = []\n    for idx, col in enumerate(b[\"columns\"]):\n        b_col_indices[col[\"name\"]] = idx\n        if col[\"name\"] != on:\n            b_other_cols.append(col)\n\n    # 결과 열 구성: a의 전부 + b의 on 아닌 것\n    result_columns = copy.deepcopy(a[\"columns\"]) + b_other_cols\n\n    # 열 이름 겹침 검사 (on 제외)\n    a_col_names_set = {col[\"name\"] for col in a[\"columns\"]}\n    for col in b_other_cols:\n        if col[\"name\"] in a_col_names_set:\n            raise NormError(f\"열 이름이 겹친다: {col['name']}\")\n\n    # b의 조인 키별 인덱스 매핑\n    b_on_idx = b_col_indices[on]\n    b_key_map = {}\n    for b_idx, b_row in enumerate(b[\"rows\"]):\n        key = b_row[b_on_idx]\n        if key is not None:  # on이 결측인 행은 무시\n            if key not in b_key_map:\n                b_key_map[key] = []\n            b_key_map[key].append(b_idx)\n\n    # a의 조인 키 인덱스\n    a_on_idx = None\n    for idx, col in enumerate(a[\"columns\"]):\n        if col[\"name\"] == on:\n            a_on_idx = idx\n            break\n\n    # 조인 실행\n    result_rows = []\n    for a_row in a[\"rows\"]:\n        a_key = a_row[a_on_idx]\n        if a_key is not None and a_key in b_key_map:\n            for b_idx in b_key_map[a_key]:\n                b_row = b[\"rows\"][b_idx]\n                # 새로운 행: a의 모든 값 + b의 on 아닌 값들\n                new_row = a_row + [b_row[b_idx] for b_idx, col in enumerate(b[\"columns\"]) if col[\"name\"] != on]\n                result_rows.append(new_row)\n\n    return {\n        \"columns\": result_columns,\n        \"rows\": result_rows\n    }\n","numLines":494,"startLine":1,"totalLines":494}},"sourceToolAssistantUUID":"b704abc2-8d69-40f4-b498-c21cde51d509","userType":"external","entrypoint":"cli","cwd":"/Users/incognito/dev/projects/palimpsest-agent-laziness","sessionId":"34d9dd87-316d-46cf-89ff-ac02b41e62ea","version":"2.1.241","gitBranch":"round/agent-laziness"}
