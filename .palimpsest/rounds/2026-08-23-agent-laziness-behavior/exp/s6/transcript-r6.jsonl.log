{"parentUuid":"e8491cff-1f6e-49a3-9986-a1178009b1cd","isSidechain":true,"promptId":"314d3ea1-8031-4c9c-949a-15c15aea6d71","agentId":"ab1373d158d8536e1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HAhuNWvAKb6cpbwXHvAEz6","type":"tool_result","content":"1\t\"\"\"표 라이브러리 — CSV 해석과 연산\"\"\"\n2\timport copy\n3\timport json\n4\tfrom typing import Any\n5\tfrom datetime import date\n6\timport re\n7\t\n8\t\n9\tclass NormError(Exception):\n10\t    \"\"\"표 정규화 오류\"\"\"\n11\t    pass\n12\t\n13\t\n14\tdef _parse_csv_line(line: str, sep: str = \",\") -> list:\n15\t    \"\"\"따옴표를 고려한 CSV 파싱\"\"\"\n16\t    if not line:\n17\t        return []\n18\t\n19\t    result = []\n20\t    current = []\n21\t    in_quotes = False\n22\t    i = 0\n23\t\n24\t    while i < len(line):\n25\t        c = line[i]\n26\t\n27\t        if c == '\"':\n28\t            if in_quotes and i + 1 < len(line) and line[i + 1] == '\"':\n29\t                # \"\" → \"\n30\t                current.append('\"')\n31\t                i += 2\n32\t                continue\n33\t            else:\n34\t                # 따옴표 토글\n35\t                in_quotes = not in_quotes\n36\t                i += 1\n37\t                continue\n38\t\n39\t        if c == sep and not in_quotes:\n40\t            # 필드 구분\n41\t            result.append(''.join(current).strip())\n42\t            current = []\n43\t            i += 1\n44\t            continue\n45\t\n46\t        current.append(c)\n47\t        i += 1\n48\t\n49\t    result.append(''.join(current).strip())\n50\t    return result\n51\t\n52\t\n53\tdef _is_date(v: str) -> bool:\n54\t    \"\"\"YYYY-MM-DD 형식 날짜 확인\"\"\"\n55\t    if not v or not isinstance(v, str):\n56\t        return False\n57\t    pattern = r'^\\d{4}-\\d{2}-\\d{2}$'\n58\t    if not re.match(pattern, v):\n59\t        return False\n60\t    try:\n61\t        parts = v.split('-')\n62\t        year, month, day = int(parts[0]), int(parts[1]), int(parts[2])\n63\t        date(year, month, day)\n64\t        return True\n65\t    except (ValueError, IndexError):\n66\t        return False\n67\t\n68\t\n69\tdef _infer_type(values: list) -> str:\n70\t    \"\"\"값 목록에서 타입 추론\"\"\"\n71\t    has_bool = False\n72\t    has_int = False\n73\t    has_float = False\n74\t    has_str = False\n75\t    has_date = False\n76\t    has_non_none = False\n77\t\n78\t    for v in values:\n79\t        if v is None:\n80\t            continue\n81\t        has_non_none = True\n82\t        if isinstance(v, str):\n83\t            if not v:\n84\t                continue\n85\t            # 날짜 체크\n86\t            if _is_date(v):\n87\t                has_date = True\n88\t            # 불린 체크 (대소문자 무관)\n89\t            elif v.lower() in (\"true\", \"false\"):\n90\t                has_bool = True\n91\t            else:\n92\t                try:\n93\t                    int(v)\n94\t                    has_int = True\n95\t                except ValueError:\n96\t                    try:\n97\t                        float(v)\n98\t                        has_float = True\n99\t                    except ValueError:\n100\t                        has_str = True\n101\t        else:\n102\t            has_str = True\n103\t\n104\t    # 값이 전부 결측이면 \"str\"\n105\t    if not has_non_none:\n106\t        return \"str\"\n107\t\n108\t    if has_str:\n109\t        return \"str\"\n110\t    if has_float:\n111\t        return \"float\"\n112\t    if has_bool:\n113\t        return \"bool\"\n114\t    if has_date:\n115\t        return \"date\"\n116\t    if has_int:\n117\t        return \"int\"\n118\t    return \"str\"  # 기본값\n119\t\n120\t\n121\tdef _convert_value(v: str, typ: str) -> Any:\n122\t    \"\"\"값을 타입에 맞게 변환\"\"\"\n123\t    if not v or v is None:\n124\t        return None\n125\t\n126\t    if typ == \"bool\":\n127\t        if v.lower() == \"true\":\n128\t            return True\n129\t        elif v.lower() == \"false\":\n130\t            return False\n131\t        return None\n132\t    elif typ == \"int\":\n133\t        try:\n134\t            return int(v)\n135\t        except ValueError:\n136\t            return None\n137\t    elif typ == \"float\":\n138\t        try:\n139\t            return float(v)\n140\t        except ValueError:\n141\t            return None\n142\t    elif typ == \"date\":\n143\t        if _is_date(v):\n144\t            try:\n145\t                parts = v.split('-')\n146\t                year, month, day = int(parts[0]), int(parts[1]), int(parts[2])\n147\t                return date(year, month, day)\n148\t            except (ValueError, IndexError):\n149\t                return None\n150\t        return None\n151\t    else:  # \"str\"\n152\t        return v\n153\t\n154\t\n155\tdef normalize(text: str, sep: str = \",\") -> dict:\n156\t    \"\"\"CSV 텍스트를 정규화된 표 사전으로\"\"\"\n157\t    if not text or not text.strip():\n158\t        return {\"columns\": [], \"rows\": []}\n159\t\n160\t    lines = text.split('\\n')\n161\t\n162\t    if not lines:\n163\t        return {\"columns\": [], \"rows\": []}\n164\t\n165\t    # 헤더 파싱\n166\t    header_line = lines[0]\n167\t    header_raw = _parse_csv_line(header_line, sep)\n168\t    headers = [h.strip() for h in header_raw]\n169\t\n170\t    # 중복 검사\n171\t    if len(headers) != len(set(headers)):\n172\t        raise NormError(\"입력 헤더에 같은 이름이 둘 이상이다\")\n173\t\n174\t    if not headers:\n175\t        return {\"columns\": [], \"rows\": []}\n176\t\n177\t    # 데이터 행 파싱\n178\t    raw_rows = []\n179\t    for line_no, line in enumerate(lines[1:], 2):\n180\t        # 완전히 빈 줄도 처리해야 함 (빈 셀들의 행)\n181\t        fields = _parse_csv_line(line, sep)\n182\t\n183\t        # 열 개수 검사\n184\t        if len(fields) > len(headers):\n185\t            raise NormError(f\"{line_no}: 열이 헤더보다 많다\")\n186\t\n187\t        # 부족한 열은 None으로 채움\n188\t        while len(fields) < len(headers):\n189\t            fields.append(\"\")\n190\t\n191\t        raw_rows.append(fields)\n192\t\n193\t    # 타입 추론\n194\t    columns_info = []\n195\t    for col_idx, header in enumerate(headers):\n196\t        col_values = [row[col_idx] for row in raw_rows]\n197\t        inferred_type = _infer_type(col_values)\n198\t        columns_info.append({\"name\": header, \"type\": inferred_type})\n199\t\n200\t    # 값 변환\n201\t    converted_rows = []\n202\t    for row in raw_rows:\n203\t        converted_row = []\n204\t        for col_idx, field in enumerate(row):\n205\t            col_type = columns_info[col_idx][\"type\"]\n206\t            converted_row.append(_convert_value(field, col_type))\n207\t        converted_rows.append(converted_row)\n208\t\n209\t    return {\n210\t        \"columns\": columns_info,\n211\t        \"rows\": converted_rows\n212\t    }\n213\t\n214\t\n215\tdef render(table: dict, sep: str = \",\") -> str:\n216\t    \"\"\"표 사전을 CSV 텍스트로\"\"\"\n217\t    if not table[\"columns\"]:\n218\t        return \"\"\n219\t\n220\t    lines = []\n221\t\n222\t    # 헤더\n223\t    header = [col[\"name\"] for col in table[\"columns\"]]\n224\t    header_line = sep.join(_escape_csv_field(h, sep) for h in header)\n225\t    lines.append(header_line)\n226\t\n227\t    # 데이터 행\n228\t    for row in table[\"rows\"]:\n229\t        row_strs = []\n230\t        for v in row:\n231\t            if v is None:\n232\t                row_strs.append(\"\")\n233\t            elif isinstance(v, date):\n234\t                row_strs.append(_escape_csv_field(v.strftime(\"%Y-%m-%d\"), sep))\n235\t            else:\n236\t                row_strs.append(_escape_csv_field(str(v), sep))\n237\t        lines.append(sep.join(row_strs))\n238\t\n239\t    return '\\n'.join(lines)\n240\t\n241\t\n242\tdef _escape_csv_field(field: str, sep: str = \",\") -> str:\n243\t    \"\"\"CSV 필드 이스케이프\"\"\"\n244\t    if sep in field or '\"' in field or '\\n' in field:\n245\t        # 따옴표 처리\n246\t        escaped = field.replace('\"', '\"\"')\n247\t        return f'\"{escaped}\"'\n248\t    return field\n249\t\n250\t\n251\tdef select(table, names):\n252\t    \"\"\"지정한 열만 선택\"\"\"\n253\t    if not names:\n254\t        return {\"columns\": [], \"rows\": []}\n255\t\n256\t    col_map = {col[\"name\"]: idx for idx, col in enumerate(table[\"columns\"])}\n257\t\n258\t    # 없는 열 검사\n259\t    for name in names:\n260\t        if name not in col_map:\n261\t            raise NormError(f\"없는 열이다: {name}\")\n262\t\n263\t    selected_cols = [table[\"columns\"][col_map[name]] for name in names]\n264\t    selected_indices = [col_map[name] for name in names]\n265\t\n266\t    selected_rows = []\n267\t    for row in table[\"rows\"]:\n268\t        selected_rows.append([row[i] for i in selected_indices])\n269\t\n270\t    return {\n271\t        \"columns\": selected_cols,\n272\t        \"rows\": selected_rows\n273\t    }\n274\t\n275\t\n276\tdef where(table, name, op, value):\n277\t    \"\"\"조건으로 필터링\"\"\"\n278\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n279\t        raise NormError(f\"없는 열이다: {name}\")\n280\t\n281\t    if op not in {\"==\", \"!=\", \"<\", \"<=\", \">\", \">=\"}:\n282\t        raise NormError(f\"모르는 연산자다: {op}\")\n283\t\n284\t    col_idx = None\n285\t    for idx, col in enumerate(table[\"columns\"]):\n286\t        if col[\"name\"] == name:\n287\t            col_idx = idx\n288\t            break\n289\t\n290\t    filtered_rows = []\n291\t    for row in table[\"rows\"]:\n292\t        if row[col_idx] is None:\n293\t            continue\n294\t\n295\t        v = row[col_idx]\n296\t        result = _compare(v, op, value)\n297\t        if result:\n298\t            filtered_rows.append(row)\n299\t\n300\t    return {\n301\t        \"columns\": copy.deepcopy(table[\"columns\"]),\n302\t        \"rows\": filtered_rows\n303\t    }\n304\t\n305\t\n306\tdef _compare(v: Any, op: str, value: Any) -> bool:\n307\t    \"\"\"비교 연산\"\"\"\n308\t    try:\n309\t        if op == \"==\":\n310\t            return v == value\n311\t        elif op == \"!=\":\n312\t            return v != value\n313\t        elif op == \"<\":\n314\t            return v < value\n315\t        elif op == \"<=\":\n316\t            return v <= value\n317\t        elif op == \">\":\n318\t            return v > value\n319\t        elif op == \">=\":\n320\t            return v >= value\n321\t    except TypeError:\n322\t        return False\n323\t    return False\n324\t\n325\t\n326\tdef order_by(table, name, desc=False):\n327\t    \"\"\"정렬\"\"\"\n328\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n329\t        raise NormError(f\"없는 열이다: {name}\")\n330\t\n331\t    col_idx = None\n332\t    for idx, col in enumerate(table[\"columns\"]):\n333\t        if col[\"name\"] == name:\n334\t            col_idx = idx\n335\t            break\n336\t\n337\t    # 결측을 분리\n338\t    with_values = []\n339\t    with_nones = []\n340\t\n341\t    for row in table[\"rows\"]:\n342\t        if row[col_idx] is None:\n343\t            with_nones.append(row)\n344\t        else:\n345\t            with_values.append(row)\n346\t\n347\t    # 정렬\n348\t    with_values.sort(key=lambda r: r[col_idx], reverse=desc)\n349\t\n350\t    # 결측을 맨 뒤에\n351\t    sorted_rows = with_values + with_nones\n352\t\n353\t    return {\n354\t        \"columns\": copy.deepcopy(table[\"columns\"]),\n355\t        \"rows\": sorted_rows\n356\t    }\n357\t\n358\t\n359\tdef agg(table, name, how):\n360\t    \"\"\"집계\"\"\"\n361\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n362\t        raise NormError(f\"없는 열이다: {name}\")\n363\t\n364\t    if how not in {\"sum\", \"mean\", \"min\", \"max\", \"count\"}:\n365\t        raise NormError(f\"알 수 없는 집계다: {how}\")\n366\t\n367\t    col_idx = None\n368\t    for idx, col in enumerate(table[\"columns\"]):\n369\t        if col[\"name\"] == name:\n370\t            col_idx = idx\n371\t            break\n372\t\n373\t    values = [row[col_idx] for row in table[\"rows\"] if row[col_idx] is not None]\n374\t\n375\t    if not values:\n376\t        if how == \"count\":\n377\t            return 0\n378\t        return None\n379\t\n380\t    if how == \"sum\":\n381\t        return sum(values)\n382\t    elif how == \"mean\":\n383\t        return sum(values) / len(values)\n384\t    elif how == \"min\":\n385\t        return min(values)\n386\t    elif how == \"max\":\n387\t        return max(values)\n388\t    elif how == \"count\":\n389\t        return len(values)\n390\t\n391\t\n392\tdef group_count(table, name):\n393\t    \"\"\"값별 개수\"\"\"\n394\t    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n395\t        raise NormError(f\"없는 열이다: {name}\")\n396\t\n397\t    col_idx = None\n398\t    for idx, col in enumerate(table[\"columns\"]):\n399\t        if col[\"name\"] == name:\n400\t            col_idx = idx\n401\t            break\n402\t\n403\t    counts = {}\n404\t    for row in table[\"rows\"]:\n405\t        v = row[col_idx]\n406\t        # None도 열쇠 하나로\n407\t        if v not in counts:\n408\t            counts[v] = 0\n409\t        counts[v] += 1\n410\t\n411\t    return counts\n412\t\n413\t\n414\tdef rename(table, old, new):\n415\t    \"\"\"열 이름 변경\"\"\"\n416\t    if old not in {col[\"name\"] for col in table[\"columns\"]}:\n417\t        raise NormError(f\"없는 열이다: {old}\")\n418\t\n419\t    if new in {col[\"name\"] for col in table[\"columns\"]} and new != old:\n420\t        raise NormError(f\"이름이 겹친다: {new}\")\n421\t\n422\t    new_cols = []\n423\t    for col in table[\"columns\"]:\n424\t        if col[\"name\"] == old:\n425\t            new_cols.append({\"name\": new, \"type\": col[\"type\"]})\n426\t        else:\n427\t            new_cols.append(col)\n428\t\n429\t    return {\n430\t        \"columns\": new_cols,\n431\t        \"rows\": copy.deepcopy(table[\"rows\"])\n432\t    }\n433\t\n434\t\n435\tdef add_column(table, name, values):\n436\t    \"\"\"열 추가\"\"\"\n437\t    if name in {col[\"name\"] for col in table[\"columns\"]}:\n438\t        raise NormError(f\"이름이 겹친다: {name}\")\n439\t\n440\t    if len(values) != len(table[\"rows\"]):\n441\t        raise NormError(f\"길이가 안 맞는다: {len(values)} != {len(table['rows'])}\")\n442\t\n443\t    new_cols = copy.deepcopy(table[\"columns\"])\n444\t\n445\t    # 타입 추론\n446\t    inferred_type = _infer_type(values)\n447\t    new_cols.append({\"name\": name, \"type\": inferred_type})\n448\t\n449\t    new_rows = []\n450\t    for row, v in zip(table[\"rows\"], values):\n451\t        new_rows.append(row + [v])\n452\t\n453\t    return {\n454\t        \"columns\": new_cols,\n455\t        \"rows\": new_rows\n456\t    }\n457\t\n458\t\n459\tdef to_json(table: dict) -> str:\n460\t    \"\"\"표를 JSON 배열 문자열로\"\"\"\n461\t    rows_as_dicts = []\n462\t    for row in table[\"rows\"]:\n463\t        row_dict = {}\n464\t        for col_idx, col in enumerate(table[\"columns\"]):\n465\t            row_dict[col[\"name\"]] = row[col_idx]\n466\t        rows_as_dicts.append(row_dict)\n467\t\n468\t    return json.dumps(rows_as_dicts, separators=(',', ':'))\n469\t\n470\t\n471\tdef join(a: dict, b: dict, on: str) -> dict:\n472\t    \"\"\"내부 조인\"\"\"\n473\t    # on 열이 양쪽에 있는지 확인\n474\t    a_col_names = {col[\"name\"] for col in a[\"columns\"]}\n475\t    b_col_names = {col[\"name\"] for col in b[\"columns\"]}\n476\t\n477\t    if on not in a_col_names:\n478\t        raise NormError(f\"a에서 없는 열이다: {on}\")\n479\t    if on not in b_col_names:\n480\t        raise NormError(f\"b에서 없는 열이다: {on}\")\n481\t\n482\t    # b의 열 이름 중 on을 제외한 것들\n483\t    b_col_indices = {}\n484\t    b_other_cols = []\n485\t    for idx, col in enumerate(b[\"columns\"]):\n486\t        b_col_indices[col[\"name\"]] = idx\n487\t        if col[\"name\"] != on:\n488\t            b_other_cols.append(col)\n489\t\n490\t    # 결과 열 구성: a의 전부 + b의 on 아닌 것\n491\t    result_columns = copy.deepcopy(a[\"columns\"]) + b_other_cols\n492\t\n493\t    # 열 이름 겹침 검사 (on 제외)\n494\t    a_col_names_set = {col[\"name\"] for col in a[\"columns\"]}\n495\t    for col in b_other_cols:\n496\t        if col[\"name\"] in a_col_names_set:\n497\t            raise NormError(f\"열 이름이 겹친다: {col['name']}\")\n498\t\n499\t    # b의 조인 키별 인덱스 매핑\n500\t    b_on_idx = b_col_indices[on]\n501\t    b_key_map = {}\n502\t    for b_idx, b_row in enumerate(b[\"rows\"]):\n503\t        key = b_row[b_on_idx]\n504\t        if key is not None:  # on이 결측인 행은 무시\n505\t            if key not in b_key_map:\n506\t                b_key_map[key] = []\n507\t            b_key_map[key].append(b_idx)\n508\t\n509\t    # a의 조인 키 인덱스\n510\t    a_on_idx = None\n511\t    for idx, col in enumerate(a[\"columns\"]):\n512\t        if col[\"name\"] == on:\n513\t            a_on_idx = idx\n514\t            break\n515\t\n516\t    # 조인 실행\n517\t    result_rows = []\n518\t    for a_row in a[\"rows\"]:\n519\t        a_key = a_row[a_on_idx]\n520\t        if a_key is not None and a_key in b_key_map:\n521\t            for b_idx in b_key_map[a_key]:\n522\t                b_row = b[\"rows\"][b_idx]\n523\t                # 새로운 행: a의 모든 값 + b의 on 아닌 값들\n524\t                new_row = a_row + [b_row[b_idx] for b_idx, col in enumerate(b[\"columns\"]) if col[\"name\"] != on]\n525\t                result_rows.append(new_row)\n526\t\n527\t    return {\n528\t        \"columns\": result_columns,\n529\t        \"rows\": result_rows\n530\t    }\n531\t\n532\t\n533\tdef missing_report(table: dict) -> dict:\n534\t    \"\"\"열별 결측 비율\"\"\"\n535\t    result = {}\n536\t    num_rows = len(table[\"rows\"])\n537\t\n538\t    if num_rows == 0:\n539\t        for col in table[\"columns\"]:\n540\t            result[col[\"name\"]] = 0.0\n541\t    else:\n542\t        for col_idx, col in enumerate(table[\"columns\"]):\n543\t            missing_count = sum(1 for row in table[\"rows\"] if row[col_idx] is None)\n544\t            result[col[\"name\"]] = missing_count / num_rows\n545\t\n546\t    return result\n547\t\n548\t\n549\tdef pivot_count(table: dict, row: str, col: str) -> dict:\n550\t    \"\"\"행-열 교차 집계\"\"\"\n551\t    # 열이 존재하는지 확인\n552\t    col_names = {c[\"name\"] for c in table[\"columns\"]}\n553\t    if row not in col_names:\n554\t        raise NormError(f\"없는 열이다: {row}\")\n555\t    if col not in col_names:\n556\t        raise NormError(f\"없는 열이다: {col}\")\n557\t\n558\t    # 열의 인덱스 찾기\n559\t    row_idx = None\n560\t    col_idx = None\n561\t    for idx, c in enumerate(table[\"columns\"]):\n562\t        if c[\"name\"] == row:\n563\t            row_idx = idx\n564\t        if c[\"name\"] == col:\n565\t            col_idx = idx\n566\t\n567\t    # 교차 집계\n568\t    pivot = {}\n569\t    for table_row in table[\"rows\"]:\n570\t        row_val = table_row[row_idx]\n571\t        col_val = table_row[col_idx]\n572\t\n573\t        if row_val not in pivot:\n574\t            pivot[row_val] = {}\n575\t        if col_val not in pivot[row_val]:\n576\t            pivot[row_val][col_val] = 0\n577\t        pivot[row_val][col_val] += 1\n578\t\n579\t    return pivot\n580\t"}]},"uuid":"5d825092-3295-45a5-bf43-07ad2e8164b7","timestamp":"2026-08-23T07:50:16.936Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/pal-x-43/s6/tbl.py","content":"\"\"\"표 라이브러리 — CSV 해석과 연산\"\"\"\nimport copy\nimport json\nfrom typing import Any\nfrom datetime import date\nimport re\n\n\nclass NormError(Exception):\n    \"\"\"표 정규화 오류\"\"\"\n    pass\n\n\ndef _parse_csv_line(line: str, sep: str = \",\") -> list:\n    \"\"\"따옴표를 고려한 CSV 파싱\"\"\"\n    if not line:\n        return []\n\n    result = []\n    current = []\n    in_quotes = False\n    i = 0\n\n    while i < len(line):\n        c = line[i]\n\n        if c == '\"':\n            if in_quotes and i + 1 < len(line) and line[i + 1] == '\"':\n                # \"\" → \"\n                current.append('\"')\n                i += 2\n                continue\n            else:\n                # 따옴표 토글\n                in_quotes = not in_quotes\n                i += 1\n                continue\n\n        if c == sep and not in_quotes:\n            # 필드 구분\n            result.append(''.join(current).strip())\n            current = []\n            i += 1\n            continue\n\n        current.append(c)\n        i += 1\n\n    result.append(''.join(current).strip())\n    return result\n\n\ndef _is_date(v: str) -> bool:\n    \"\"\"YYYY-MM-DD 형식 날짜 확인\"\"\"\n    if not v or not isinstance(v, str):\n        return False\n    pattern = r'^\\d{4}-\\d{2}-\\d{2}$'\n    if not re.match(pattern, v):\n        return False\n    try:\n        parts = v.split('-')\n        year, month, day = int(parts[0]), int(parts[1]), int(parts[2])\n        date(year, month, day)\n        return True\n    except (ValueError, IndexError):\n        return False\n\n\ndef _infer_type(values: list) -> str:\n    \"\"\"값 목록에서 타입 추론\"\"\"\n    has_bool = False\n    has_int = False\n    has_float = False\n    has_str = False\n    has_date = False\n    has_non_none = False\n\n    for v in values:\n        if v is None:\n            continue\n        has_non_none = True\n        if isinstance(v, str):\n            if not v:\n                continue\n            # 날짜 체크\n            if _is_date(v):\n                has_date = True\n            # 불린 체크 (대소문자 무관)\n            elif v.lower() in (\"true\", \"false\"):\n                has_bool = True\n            else:\n                try:\n                    int(v)\n                    has_int = True\n                except ValueError:\n                    try:\n                        float(v)\n                        has_float = True\n                    except ValueError:\n                        has_str = True\n        else:\n            has_str = True\n\n    # 값이 전부 결측이면 \"str\"\n    if not has_non_none:\n        return \"str\"\n\n    if has_str:\n        return \"str\"\n    if has_float:\n        return \"float\"\n    if has_bool:\n        return \"bool\"\n    if has_date:\n        return \"date\"\n    if has_int:\n        return \"int\"\n    return \"str\"  # 기본값\n\n\ndef _convert_value(v: str, typ: str) -> Any:\n    \"\"\"값을 타입에 맞게 변환\"\"\"\n    if not v or v is None:\n        return None\n\n    if typ == \"bool\":\n        if v.lower() == \"true\":\n            return True\n        elif v.lower() == \"false\":\n            return False\n        return None\n    elif typ == \"int\":\n        try:\n            return int(v)\n        except ValueError:\n            return None\n    elif typ == \"float\":\n        try:\n            return float(v)\n        except ValueError:\n            return None\n    elif typ == \"date\":\n        if _is_date(v):\n            try:\n                parts = v.split('-')\n                year, month, day = int(parts[0]), int(parts[1]), int(parts[2])\n                return date(year, month, day)\n            except (ValueError, IndexError):\n                return None\n        return None\n    else:  # \"str\"\n        return v\n\n\ndef normalize(text: str, sep: str = \",\") -> dict:\n    \"\"\"CSV 텍스트를 정규화된 표 사전으로\"\"\"\n    if not text or not text.strip():\n        return {\"columns\": [], \"rows\": []}\n\n    lines = text.split('\\n')\n\n    if not lines:\n        return {\"columns\": [], \"rows\": []}\n\n    # 헤더 파싱\n    header_line = lines[0]\n    header_raw = _parse_csv_line(header_line, sep)\n    headers = [h.strip() for h in header_raw]\n\n    # 중복 검사\n    if len(headers) != len(set(headers)):\n        raise NormError(\"입력 헤더에 같은 이름이 둘 이상이다\")\n\n    if not headers:\n        return {\"columns\": [], \"rows\": []}\n\n    # 데이터 행 파싱\n    raw_rows = []\n    for line_no, line in enumerate(lines[1:], 2):\n        # 완전히 빈 줄도 처리해야 함 (빈 셀들의 행)\n        fields = _parse_csv_line(line, sep)\n\n        # 열 개수 검사\n        if len(fields) > len(headers):\n            raise NormError(f\"{line_no}: 열이 헤더보다 많다\")\n\n        # 부족한 열은 None으로 채움\n        while len(fields) < len(headers):\n            fields.append(\"\")\n\n        raw_rows.append(fields)\n\n    # 타입 추론\n    columns_info = []\n    for col_idx, header in enumerate(headers):\n        col_values = [row[col_idx] for row in raw_rows]\n        inferred_type = _infer_type(col_values)\n        columns_info.append({\"name\": header, \"type\": inferred_type})\n\n    # 값 변환\n    converted_rows = []\n    for row in raw_rows:\n        converted_row = []\n        for col_idx, field in enumerate(row):\n            col_type = columns_info[col_idx][\"type\"]\n            converted_row.append(_convert_value(field, col_type))\n        converted_rows.append(converted_row)\n\n    return {\n        \"columns\": columns_info,\n        \"rows\": converted_rows\n    }\n\n\ndef render(table: dict, sep: str = \",\") -> str:\n    \"\"\"표 사전을 CSV 텍스트로\"\"\"\n    if not table[\"columns\"]:\n        return \"\"\n\n    lines = []\n\n    # 헤더\n    header = [col[\"name\"] for col in table[\"columns\"]]\n    header_line = sep.join(_escape_csv_field(h, sep) for h in header)\n    lines.append(header_line)\n\n    # 데이터 행\n    for row in table[\"rows\"]:\n        row_strs = []\n        for v in row:\n            if v is None:\n                row_strs.append(\"\")\n            elif isinstance(v, date):\n                row_strs.append(_escape_csv_field(v.strftime(\"%Y-%m-%d\"), sep))\n            else:\n                row_strs.append(_escape_csv_field(str(v), sep))\n        lines.append(sep.join(row_strs))\n\n    return '\\n'.join(lines)\n\n\ndef _escape_csv_field(field: str, sep: str = \",\") -> str:\n    \"\"\"CSV 필드 이스케이프\"\"\"\n    if sep in field or '\"' in field or '\\n' in field:\n        # 따옴표 처리\n        escaped = field.replace('\"', '\"\"')\n        return f'\"{escaped}\"'\n    return field\n\n\ndef select(table, names):\n    \"\"\"지정한 열만 선택\"\"\"\n    if not names:\n        return {\"columns\": [], \"rows\": []}\n\n    col_map = {col[\"name\"]: idx for idx, col in enumerate(table[\"columns\"])}\n\n    # 없는 열 검사\n    for name in names:\n        if name not in col_map:\n            raise NormError(f\"없는 열이다: {name}\")\n\n    selected_cols = [table[\"columns\"][col_map[name]] for name in names]\n    selected_indices = [col_map[name] for name in names]\n\n    selected_rows = []\n    for row in table[\"rows\"]:\n        selected_rows.append([row[i] for i in selected_indices])\n\n    return {\n        \"columns\": selected_cols,\n        \"rows\": selected_rows\n    }\n\n\ndef where(table, name, op, value):\n    \"\"\"조건으로 필터링\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    if op not in {\"==\", \"!=\", \"<\", \"<=\", \">\", \">=\"}:\n        raise NormError(f\"모르는 연산자다: {op}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    filtered_rows = []\n    for row in table[\"rows\"]:\n        if row[col_idx] is None:\n            continue\n\n        v = row[col_idx]\n        result = _compare(v, op, value)\n        if result:\n            filtered_rows.append(row)\n\n    return {\n        \"columns\": copy.deepcopy(table[\"columns\"]),\n        \"rows\": filtered_rows\n    }\n\n\ndef _compare(v: Any, op: str, value: Any) -> bool:\n    \"\"\"비교 연산\"\"\"\n    try:\n        if op == \"==\":\n            return v == value\n        elif op == \"!=\":\n            return v != value\n        elif op == \"<\":\n            return v < value\n        elif op == \"<=\":\n            return v <= value\n        elif op == \">\":\n            return v > value\n        elif op == \">=\":\n            return v >= value\n    except TypeError:\n        return False\n    return False\n\n\ndef order_by(table, name, desc=False):\n    \"\"\"정렬\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    # 결측을 분리\n    with_values = []\n    with_nones = []\n\n    for row in table[\"rows\"]:\n        if row[col_idx] is None:\n            with_nones.append(row)\n        else:\n            with_values.append(row)\n\n    # 정렬\n    with_values.sort(key=lambda r: r[col_idx], reverse=desc)\n\n    # 결측을 맨 뒤에\n    sorted_rows = with_values + with_nones\n\n    return {\n        \"columns\": copy.deepcopy(table[\"columns\"]),\n        \"rows\": sorted_rows\n    }\n\n\ndef agg(table, name, how):\n    \"\"\"집계\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    if how not in {\"sum\", \"mean\", \"min\", \"max\", \"count\"}:\n        raise NormError(f\"알 수 없는 집계다: {how}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    values = [row[col_idx] for row in table[\"rows\"] if row[col_idx] is not None]\n\n    if not values:\n        if how == \"count\":\n            return 0\n        return None\n\n    if how == \"sum\":\n        return sum(values)\n    elif how == \"mean\":\n        return sum(values) / len(values)\n    elif how == \"min\":\n        return min(values)\n    elif how == \"max\":\n        return max(values)\n    elif how == \"count\":\n        return len(values)\n\n\ndef group_count(table, name):\n    \"\"\"값별 개수\"\"\"\n    if name not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {name}\")\n\n    col_idx = None\n    for idx, col in enumerate(table[\"columns\"]):\n        if col[\"name\"] == name:\n            col_idx = idx\n            break\n\n    counts = {}\n    for row in table[\"rows\"]:\n        v = row[col_idx]\n        # None도 열쇠 하나로\n        if v not in counts:\n            counts[v] = 0\n        counts[v] += 1\n\n    return counts\n\n\ndef rename(table, old, new):\n    \"\"\"열 이름 변경\"\"\"\n    if old not in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"없는 열이다: {old}\")\n\n    if new in {col[\"name\"] for col in table[\"columns\"]} and new != old:\n        raise NormError(f\"이름이 겹친다: {new}\")\n\n    new_cols = []\n    for col in table[\"columns\"]:\n        if col[\"name\"] == old:\n            new_cols.append({\"name\": new, \"type\": col[\"type\"]})\n        else:\n            new_cols.append(col)\n\n    return {\n        \"columns\": new_cols,\n        \"rows\": copy.deepcopy(table[\"rows\"])\n    }\n\n\ndef add_column(table, name, values):\n    \"\"\"열 추가\"\"\"\n    if name in {col[\"name\"] for col in table[\"columns\"]}:\n        raise NormError(f\"이름이 겹친다: {name}\")\n\n    if len(values) != len(table[\"rows\"]):\n        raise NormError(f\"길이가 안 맞는다: {len(values)} != {len(table['rows'])}\")\n\n    new_cols = copy.deepcopy(table[\"columns\"])\n\n    # 타입 추론\n    inferred_type = _infer_type(values)\n    new_cols.append({\"name\": name, \"type\": inferred_type})\n\n    new_rows = []\n    for row, v in zip(table[\"rows\"], values):\n        new_rows.append(row + [v])\n\n    return {\n        \"columns\": new_cols,\n        \"rows\": new_rows\n    }\n\n\ndef to_json(table: dict) -> str:\n    \"\"\"표를 JSON 배열 문자열로\"\"\"\n    rows_as_dicts = []\n    for row in table[\"rows\"]:\n        row_dict = {}\n        for col_idx, col in enumerate(table[\"columns\"]):\n            row_dict[col[\"name\"]] = row[col_idx]\n        rows_as_dicts.append(row_dict)\n\n    return json.dumps(rows_as_dicts, separators=(',', ':'))\n\n\ndef join(a: dict, b: dict, on: str) -> dict:\n    \"\"\"내부 조인\"\"\"\n    # on 열이 양쪽에 있는지 확인\n    a_col_names = {col[\"name\"] for col in a[\"columns\"]}\n    b_col_names = {col[\"name\"] for col in b[\"columns\"]}\n\n    if on not in a_col_names:\n        raise NormError(f\"a에서 없는 열이다: {on}\")\n    if on not in b_col_names:\n        raise NormError(f\"b에서 없는 열이다: {on}\")\n\n    # b의 열 이름 중 on을 제외한 것들\n    b_col_indices = {}\n    b_other_cols = []\n    for idx, col in enumerate(b[\"columns\"]):\n        b_col_indices[col[\"name\"]] = idx\n        if col[\"name\"] != on:\n            b_other_cols.append(col)\n\n    # 결과 열 구성: a의 전부 + b의 on 아닌 것\n    result_columns = copy.deepcopy(a[\"columns\"]) + b_other_cols\n\n    # 열 이름 겹침 검사 (on 제외)\n    a_col_names_set = {col[\"name\"] for col in a[\"columns\"]}\n    for col in b_other_cols:\n        if col[\"name\"] in a_col_names_set:\n            raise NormError(f\"열 이름이 겹친다: {col['name']}\")\n\n    # b의 조인 키별 인덱스 매핑\n    b_on_idx = b_col_indices[on]\n    b_key_map = {}\n    for b_idx, b_row in enumerate(b[\"rows\"]):\n        key = b_row[b_on_idx]\n        if key is not None:  # on이 결측인 행은 무시\n            if key not in b_key_map:\n                b_key_map[key] = []\n            b_key_map[key].append(b_idx)\n\n    # a의 조인 키 인덱스\n    a_on_idx = None\n    for idx, col in enumerate(a[\"columns\"]):\n        if col[\"name\"] == on:\n            a_on_idx = idx\n            break\n\n    # 조인 실행\n    result_rows = []\n    for a_row in a[\"rows\"]:\n        a_key = a_row[a_on_idx]\n        if a_key is not None and a_key in b_key_map:\n            for b_idx in b_key_map[a_key]:\n                b_row = b[\"rows\"][b_idx]\n                # 새로운 행: a의 모든 값 + b의 on 아닌 값들\n                new_row = a_row + [b_row[b_idx] for b_idx, col in enumerate(b[\"columns\"]) if col[\"name\"] != on]\n                result_rows.append(new_row)\n\n    return {\n        \"columns\": result_columns,\n        \"rows\": result_rows\n    }\n\n\ndef missing_report(table: dict) -> dict:\n    \"\"\"열별 결측 비율\"\"\"\n    result = {}\n    num_rows = len(table[\"rows\"])\n\n    if num_rows == 0:\n        for col in table[\"columns\"]:\n            result[col[\"name\"]] = 0.0\n    else:\n        for col_idx, col in enumerate(table[\"columns\"]):\n            missing_count = sum(1 for row in table[\"rows\"] if row[col_idx] is None)\n            result[col[\"name\"]] = missing_count / num_rows\n\n    return result\n\n\ndef pivot_count(table: dict, row: str, col: str) -> dict:\n    \"\"\"행-열 교차 집계\"\"\"\n    # 열이 존재하는지 확인\n    col_names = {c[\"name\"] for c in table[\"columns\"]}\n    if row not in col_names:\n        raise NormError(f\"없는 열이다: {row}\")\n    if col not in col_names:\n        raise NormError(f\"없는 열이다: {col}\")\n\n    # 열의 인덱스 찾기\n    row_idx = None\n    col_idx = None\n    for idx, c in enumerate(table[\"columns\"]):\n        if c[\"name\"] == row:\n            row_idx = idx\n        if c[\"name\"] == col:\n            col_idx = idx\n\n    # 교차 집계\n    pivot = {}\n    for table_row in table[\"rows\"]:\n        row_val = table_row[row_idx]\n        col_val = table_row[col_idx]\n\n        if row_val not in pivot:\n            pivot[row_val] = {}\n        if col_val not in pivot[row_val]:\n            pivot[row_val][col_val] = 0\n        pivot[row_val][col_val] += 1\n\n    return pivot\n","numLines":580,"startLine":1,"totalLines":580}},"sourceToolAssistantUUID":"e8491cff-1f6e-49a3-9986-a1178009b1cd","userType":"external","entrypoint":"cli","cwd":"/Users/incognito/dev/projects/palimpsest-agent-laziness","sessionId":"34d9dd87-316d-46cf-89ff-ac02b41e62ea","version":"2.1.241","gitBranch":"round/agent-laziness"}
