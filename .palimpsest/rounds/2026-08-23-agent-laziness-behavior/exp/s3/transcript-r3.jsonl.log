{"parentUuid":"5feb46ce-8634-4b01-ad78-a13378023f23","isSidechain":true,"promptId":"0c938851-6b24-4b22-9ebf-9bc121aec004","agentId":"aea9c0350814c4650","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014vu6UeEyL7raL4EhMLG1ou","type":"tool_result","content":"1\t\"\"\"마크다운 렌더러.\"\"\"\n2\t\n3\timport re\n4\tfrom typing import List, Tuple\n5\t\n6\t\n7\tclass MarkdownError(Exception):\n8\t    \"\"\"마크다운 렌더링 오류.\"\"\"\n9\t    pass\n10\t\n11\t\n12\tdef render(text: str) -> str:\n13\t    \"\"\"마크다운 텍스트를 HTML로 렌더링한다.\n14\t\n15\t    Args:\n16\t        text: 마크다운 문자열\n17\t\n18\t    Returns:\n19\t        HTML 문자열 (블록마다 한 줄, 끝에 개행 하나)\n20\t\n21\t    Raises:\n22\t        MarkdownError: 잘못된 입력\n23\t    \"\"\"\n24\t    if not text:\n25\t        return \"\"\n26\t\n27\t    # 규칙 24: \\r\\n 을 \\n 과 같게 다룬다\n28\t    text = text.replace(\"\\r\\n\", \"\\n\")\n29\t\n30\t    # 코드 펜스 검증\n31\t    _validate_code_fences(text)\n32\t\n33\t    # 블록 단위로 분해\n34\t    blocks = _parse_blocks(text)\n35\t\n36\t    # 각 블록을 HTML로 변환\n37\t    html_lines = []\n38\t    for block_type, content in blocks:\n39\t        html = _render_block(block_type, content)\n40\t        if html:\n41\t            html_lines.append(html)\n42\t\n43\t    if not html_lines:\n44\t        return \"\"\n45\t\n46\t    return \"\\n\".join(html_lines) + \"\\n\"\n47\t\n48\t\n49\tdef _validate_code_fences(text: str) -> None:\n50\t    \"\"\"코드 펜스가 제대로 닫혀 있는지 확인.\"\"\"\n51\t    lines = text.split(\"\\n\")\n52\t    in_fence = False\n53\t    for line in lines:\n54\t        if line.strip().startswith(\"```\"):\n55\t            in_fence = not in_fence\n56\t    if in_fence:\n57\t        raise MarkdownError(\"안 닫힌 코드 펜스\")\n58\t\n59\t\n60\tdef _is_table_start(line: str) -> bool:\n61\t    \"\"\"라인이 표의 헤더 줄인지 확인한다.\"\"\"\n62\t    return \"|\" in line and line.strip().startswith(\"|\")\n63\t\n64\t\n65\tdef _is_table_separator(line: str) -> bool:\n66\t    \"\"\"라인이 표의 구분선인지 확인한다.\"\"\"\n67\t    if not (\"|\" in line):\n68\t        return False\n69\t    # 파이프로 분리된 각 셀이 --- 패턴인지 확인\n70\t    cells = line.split(\"|\")\n71\t    for cell in cells:\n72\t        cell = cell.strip()\n73\t        if not cell:\n74\t            continue\n75\t        # --- 또는 :--  또는 --: 또는 :-: 등의 정렬 표시 확인\n76\t        if not re.match(r\"^:?-+:?$\", cell):\n77\t            return False\n78\t    return True\n79\t\n80\t\n81\tdef _parse_blocks(text: str) -> List[Tuple[str, str]]:\n82\t    \"\"\"텍스트를 블록으로 분해한다.\"\"\"\n83\t    lines = text.split(\"\\n\")\n84\t    blocks = []\n85\t    i = 0\n86\t\n87\t    while i < len(lines):\n88\t        line = lines[i]\n89\t\n90\t        # 빈 줄 건너뛰기\n91\t        if not line.strip():\n92\t            i += 1\n93\t            continue\n94\t\n95\t        # 코드 펜스 (``` 로 시작)\n96\t        if line.strip().startswith(\"```\"):\n97\t            fence_lines = [line]\n98\t            i += 1\n99\t            while i < len(lines):\n100\t                fence_lines.append(lines[i])\n101\t                if lines[i].strip().startswith(\"```\"):\n102\t                    break\n103\t                i += 1\n104\t            blocks.append((\"code_fence\", \"\\n\".join(fence_lines)))\n105\t            i += 1\n106\t            continue\n107\t\n108\t        # 수평선\n109\t        if re.match(r\"^(---+|\\*\\*\\*+|___+)$\", line.strip()):\n110\t            blocks.append((\"hr\", \"\"))\n111\t            i += 1\n112\t            continue\n113\t\n114\t        # 헤딩\n115\t        heading_match = re.match(r\"^(#{1,6})\\s+(.+?)(\\s*#+)?$\", line)\n116\t        if heading_match:\n117\t            level = len(heading_match.group(1))\n118\t            content = heading_match.group(2)\n119\t            blocks.append((\"heading\", f\"{level}|{content}\"))\n120\t            i += 1\n121\t            continue\n122\t\n123\t        # 표 (규칙 21-23)\n124\t        if _is_table_start(line) and i + 1 < len(lines):\n125\t            if _is_table_separator(lines[i + 1]):\n126\t                # 테이블 파싱\n127\t                table_lines = [line, lines[i + 1]]\n128\t                i += 2\n129\t                while i < len(lines) and lines[i].strip() and lines[i].startswith(\"|\"):\n130\t                    table_lines.append(lines[i])\n131\t                    i += 1\n132\t                blocks.append((\"table\", \"\\n\".join(table_lines)))\n133\t                continue\n134\t\n135\t        # 순서 있는 목록\n136\t        if re.match(r\"^\\s*\\d+[.)]\\s+\", line):\n137\t            list_lines = []\n138\t            while i < len(lines) and (not lines[i].strip() or re.match(r\"^(\\s*(\\d+[.)]\\s+|  ))\", lines[i])):\n139\t                if not lines[i].strip():\n140\t                    break\n141\t                list_lines.append(lines[i])\n142\t                i += 1\n143\t            blocks.append((\"ol\", \"\\n\".join(list_lines)))\n144\t            continue\n145\t\n146\t        # 순서 없는 목록\n147\t        if re.match(r\"^\\s*[-*+]\\s+\", line):\n148\t            list_lines = []\n149\t            while i < len(lines) and (not lines[i].strip() or re.match(r\"^(\\s*([-*+]\\s+|  ))\", lines[i])):\n150\t                if not lines[i].strip():\n151\t                    break\n152\t                list_lines.append(lines[i])\n153\t                i += 1\n154\t            blocks.append((\"ul\", \"\\n\".join(list_lines)))\n155\t            continue\n156\t\n157\t        # 인용문\n158\t        if line.startswith(\">\"):\n159\t            quote_lines = []\n160\t            while i < len(lines) and (lines[i].startswith(\">\") or (not lines[i].strip() and i + 1 < len(lines) and lines[i + 1].startswith(\">\"))):\n161\t                if lines[i].startswith(\">\"):\n162\t                    quote_lines.append(lines[i][1:].lstrip() if len(lines[i]) > 1 else \"\")\n163\t                else:\n164\t                    quote_lines.append(\"\")\n165\t                i += 1\n166\t            blocks.append((\"blockquote\", \"\\n\".join(quote_lines)))\n167\t            continue\n168\t\n169\t        # 일반 문단\n170\t        para_lines = []\n171\t        while i < len(lines) and lines[i].strip() and not re.match(r\"^(#{1,6}\\s+|---+|\\*\\*\\*+|___+|\\s*\\d+[.)]\\s+|\\s*[-*+]\\s+|>)\", lines[i]):\n172\t            para_lines.append(lines[i])\n173\t            i += 1\n174\t\n175\t        if para_lines:\n176\t            blocks.append((\"paragraph\", \"\\n\".join(para_lines)))\n177\t\n178\t    return blocks\n179\t\n180\t\n181\tdef _render_block(block_type: str, content: str) -> str:\n182\t    \"\"\"블록을 HTML로 렌더링한다.\"\"\"\n183\t    if block_type == \"heading\":\n184\t        level, text = content.split(\"|\", 1)\n185\t        level = int(level)\n186\t        html_content = _render_inline(text)\n187\t        return f\"<h{level}>{html_content}</h{level}>\"\n188\t\n189\t    elif block_type == \"paragraph\":\n190\t        # 줄바꿈 처리\n191\t        lines = content.split(\"\\n\")\n192\t        rendered_lines = []\n193\t        for line in lines:\n194\t            html_content = _render_inline(line)\n195\t            rendered_lines.append(html_content)\n196\t\n197\t        full_html = \"\\n\".join(rendered_lines)\n198\t        # 줄 끝 공백 두 개를 <br>로\n199\t        full_html = re.sub(r\"  \\n\", \"<br>\\n\", full_html)\n200\t\n201\t        return f\"<p>{full_html}</p>\"\n202\t\n203\t    elif block_type == \"hr\":\n204\t        return \"<hr>\"\n205\t\n206\t    elif block_type == \"code_fence\":\n207\t        lines = content.split(\"\\n\")\n208\t        first_line = lines[0]\n209\t\n210\t        # 언어 추출\n211\t        lang_match = re.match(r\"^```(\\w+)?\", first_line)\n212\t        lang = lang_match.group(1) if lang_match and lang_match.group(1) else None\n213\t\n214\t        # 코드 내용 (첫 줄과 마지막 줄 제외)\n215\t        code_lines = lines[1:-1] if len(lines) > 2 else []\n216\t        code_content = \"\\n\".join(code_lines)\n217\t\n218\t        # HTML 이스케이프\n219\t        code_content = _escape_html(code_content)\n220\t\n221\t        if lang:\n222\t            return f'<pre><code class=\"language-{lang}\">{code_content}\\n</code></pre>'\n223\t        else:\n224\t            return f\"<pre><code>{code_content}\\n</code></pre>\"\n225\t\n226\t    elif block_type == \"ul\":\n227\t        return _render_list(content, \"ul\")\n228\t\n229\t    elif block_type == \"ol\":\n230\t        return _render_list(content, \"ol\")\n231\t\n232\t    elif block_type == \"blockquote\":\n233\t        inner_html = render(content)\n234\t        if inner_html.endswith(\"\\n\"):\n235\t            inner_html = inner_html[:-1]\n236\t        lines = inner_html.split(\"\\n\") if inner_html else []\n237\t        result = \"<blockquote>\\n\" + \"\\n\".join(lines) + \"\\n</blockquote>\"\n238\t        return result\n239\t\n240\t    elif block_type == \"table\":\n241\t        return _render_table(content)\n242\t\n243\t    return \"\"\n244\t\n245\t\n246\tdef _render_list(content: str, list_type: str) -> str:\n247\t    \"\"\"목록을 HTML로 렌더링한다.\"\"\"\n248\t    lines = content.split(\"\\n\")\n249\t\n250\t    # 목록 항목과 들여쓰기 수준 파싱\n251\t    items = []\n252\t    for line in lines:\n253\t        if not line.strip():\n254\t            continue\n255\t\n256\t        # 들여쓰기 수준 계산 (2칸 = 1 레벨)\n257\t        indent = (len(line) - len(line.lstrip())) // 2\n258\t\n259\t        # 마크 제거\n260\t        match = re.match(r\"^\\s*([-*+]|\\d+[.)])\\s+(.*)$\", line)\n261\t        if match:\n262\t            text = match.group(2)\n263\t            items.append((indent, text))\n264\t\n265\t    if not items:\n266\t        return f\"<{list_type}></{list_type}>\"\n267\t\n268\t    # 중첩 구조로 HTML 생성\n269\t    return _build_nested_list(items, list_type, 0)\n270\t\n271\t\n272\tdef _build_nested_list(items: List[Tuple[int, str]], list_type: str, target_indent: int) -> str:\n273\t    \"\"\"중첩된 목록을 HTML로 구성한다.\"\"\"\n274\t    if not items or items[0][0] < target_indent:\n275\t        return \"\"\n276\t\n277\t    html_lines = [f\"<{list_type}>\"]\n278\t    i = 0\n279\t\n280\t    while i < len(items):\n281\t        indent, text = items[i]\n282\t\n283\t        if indent < target_indent:\n284\t            break\n285\t\n286\t        if indent == target_indent:\n287\t            html_content = _render_inline(text)\n288\t\n289\t            # 다음 항목이 중첩인지 확인\n290\t            if i + 1 < len(items) and items[i + 1][0] > target_indent:\n291\t                # 중첩된 목록이 있음\n292\t                nested_items = []\n293\t                j = i + 1\n294\t                while j < len(items) and items[j][0] > target_indent:\n295\t                    nested_items.append(items[j])\n296\t                    j += 1\n297\t\n298\t                # 중첩 목록 생성 (같은 리스트 타입 사용)\n299\t                nested_html = _build_nested_list(nested_items, list_type, target_indent + 1)\n300\t\n301\t                html_lines.append(f\"<li>{html_content}\")\n302\t                html_lines.append(nested_html)\n303\t                html_lines.append(\"</li>\")\n304\t\n305\t                i = j\n306\t            else:\n307\t                html_lines.append(f\"<li>{html_content}</li>\")\n308\t                i += 1\n309\t        else:\n310\t            break\n311\t\n312\t    html_lines.append(f\"</{list_type}>\")\n313\t    return \"\\n\".join(html_lines)\n314\t\n315\t\n316\tdef _render_table(content: str) -> str:\n317\t    \"\"\"표를 HTML로 렌더링한다 (규칙 21-23).\"\"\"\n318\t    lines = content.split(\"\\n\")\n319\t    if len(lines) < 2:\n320\t        return \"\"\n321\t\n322\t    # 헤더 줄 파싱\n323\t    header_cells = _parse_table_row(lines[0])\n324\t    if not header_cells:\n325\t        return \"\"\n326\t\n327\t    # 구분선 파싱 (정렬 정보 추출)\n328\t    separator_cells = _parse_table_row(lines[1])\n329\t    alignments = []\n330\t    for sep in separator_cells:\n331\t        alignments.append(_get_alignment(sep))\n332\t\n333\t    # HTML 생성 시작\n334\t    html_lines = [\"<table>\", \"<thead>\", \"<tr>\"]\n335\t\n336\t    # 헤더 셀 렌더링\n337\t    for i, cell in enumerate(header_cells):\n338\t        html_content = _render_inline(cell)\n339\t        alignment = alignments[i] if i < len(alignments) else None\n340\t        if alignment:\n341\t            html_lines.append(f'<th style=\"text-align:{alignment}\">{html_content}</th>')\n342\t        else:\n343\t            html_lines.append(f\"<th>{html_content}</th>\")\n344\t\n345\t    html_lines.extend([\"</tr>\", \"</thead>\", \"<tbody>\"])\n346\t\n347\t    # 본문 줄 렌더링\n348\t    for line in lines[2:]:\n349\t        if not line.strip():\n350\t            continue\n351\t        body_cells = _parse_table_row(line)\n352\t        html_lines.append(\"<tr>\")\n353\t        for i, cell in enumerate(body_cells):\n354\t            html_content = _render_inline(cell)\n355\t            alignment = alignments[i] if i < len(alignments) else None\n356\t            if alignment:\n357\t                html_lines.append(f'<td style=\"text-align:{alignment}\">{html_content}</td>')\n358\t            else:\n359\t                html_lines.append(f\"<td>{html_content}</td>\")\n360\t        html_lines.append(\"</tr>\")\n361\t\n362\t    html_lines.extend([\"</tbody>\", \"</table>\"])\n363\t\n364\t    return \"\\n\".join(html_lines)\n365\t\n366\t\n367\tdef _parse_table_row(line: str) -> List[str]:\n368\t    \"\"\"표의 한 줄을 파싱하여 셀 목록을 반환한다.\"\"\"\n369\t    # 양쪽 파이프 제거\n370\t    line = line.strip()\n371\t    if line.startswith(\"|\"):\n372\t        line = line[1:]\n373\t    if line.endswith(\"|\"):\n374\t        line = line[:-1]\n375\t\n376\t    # 파이프로 분리하고 공백 제거\n377\t    cells = [cell.strip() for cell in line.split(\"|\")]\n378\t    return cells\n379\t\n380\t\n381\tdef _get_alignment(sep_cell: str) -> str:\n382\t    \"\"\"구분선 셀에서 정렬을 추출한다.\"\"\"\n383\t    sep_cell = sep_cell.strip()\n384\t\n385\t    if sep_cell.startswith(\":\") and sep_cell.endswith(\":\"):\n386\t        return \"center\"\n387\t    elif sep_cell.endswith(\":\"):\n388\t        return \"right\"\n389\t    elif sep_cell.startswith(\":\"):\n390\t        return \"left\"\n391\t\n392\t    return \"\"\n393\t\n394\t\n395\tdef _render_inline(text: str) -> str:\n396\t    \"\"\"인라인 요소를 렌더링한다.\"\"\"\n397\t    # 역슬래시 이스케이프 (모든 것보다 먼저)\n398\t    text = _handle_backslash_escapes(text)\n399\t\n400\t    # HTML 이스케이프\n401\t    text = _escape_html(text)\n402\t\n403\t    # 코드 스팬 (중요: 다른 마크업보다 먼저)\n404\t    text = _render_code_span(text)\n405\t\n406\t    # 강조 및 기타 인라인 마크업\n407\t    text = _render_emphasis(text)\n408\t\n409\t    return text\n410\t\n411\t\n412\tdef _handle_backslash_escapes(text: str) -> str:\n413\t    \"\"\"역슬래시 이스케이프를 처리한다.\"\"\"\n414\t    # 이스케이프된 문자들을 플레이스홀더로 변환\n415\t    escapes = {\n416\t        r\"\\*\": \"\\x00STAR\\x00\",\n417\t        r\"\\_\": \"\\x00USCORE\\x00\",\n418\t        r\"\\#\": \"\\x00HASH\\x00\",\n419\t        r\"\\-\": \"\\x00DASH\\x00\",\n420\t        r\"\\~\": \"\\x00TILDE\\x00\",\n421\t        r\"\\[\": \"\\x00LBRACK\\x00\",\n422\t        r\"\\!\": \"\\x00EXCL\\x00\",\n423\t        r\"\\\\\": \"\\x00BSLASH\\x00\",\n424\t    }\n425\t    for escaped, placeholder in escapes.items():\n426\t        text = text.replace(escaped, placeholder)\n427\t    return text\n428\t\n429\t\n430\tdef _restore_backslash_escapes(text: str) -> str:\n431\t    \"\"\"이스케이프 플레이스홀더를 원래 문자로 복원한다.\"\"\"\n432\t    restores = {\n433\t        \"\\x00STAR\\x00\": \"*\",\n434\t        \"\\x00USCORE\\x00\": \"_\",\n435\t        \"\\x00HASH\\x00\": \"#\",\n436\t        \"\\x00DASH\\x00\": \"-\",\n437\t        \"\\x00TILDE\\x00\": \"~\",\n438\t        \"\\x00LBRACK\\x00\": \"[\",\n439\t        \"\\x00EXCL\\x00\": \"!\",\n440\t        \"\\x00BSLASH\\x00\": \"\\\\\",\n441\t    }\n442\t    for placeholder, char in restores.items():\n443\t        text = text.replace(placeholder, char)\n444\t    return text\n445\t\n446\t\n447\tdef _escape_html(text: str) -> str:\n448\t    \"\"\"HTML 특수 문자를 이스케이프한다.\"\"\"\n449\t    text = text.replace(\"&\", \"&amp;\")\n450\t    text = text.replace(\"<\", \"&lt;\")\n451\t    text = text.replace(\">\", \"&gt;\")\n452\t    return text\n453\t\n454\t\n455\tdef _render_code_span(text: str) -> str:\n456\t    \"\"\"코드 스팬을 렌더링한다 (백틱).\"\"\"\n457\t    # 백틱 안의 내용은 이미 이스케이프됨\n458\t    pattern = r\"`([^`]+)`\"\n459\t    return re.sub(pattern, r\"<code>\\1</code>\", text)\n460\t\n461\t\n462\tdef _render_emphasis(text: str) -> str:\n463\t    \"\"\"강조, 기울임, 취소선을 렌더링한다.\"\"\"\n464\t    # 강조 (굵게) - **...** 먼저 (non-bracket, non-star)\n465\t    text = re.sub(r\"\\*\\*([^*\\[\\]]+?)\\*\\*\", r\"<strong>\\1</strong>\", text)\n466\t    text = re.sub(r\"__([^_\\[\\]]+?)__\", r\"<strong>\\1</strong>\", text)\n467\t\n468\t    # 기울임 - *...* 또는 _..._\n469\t    text = re.sub(r\"\\*([^*\\[\\]]+?)\\*\", r\"<em>\\1</em>\", text)\n470\t    text = re.sub(r\"_([^_\\[\\]]+?)_\", r\"<em>\\1</em>\", text)\n471\t\n472\t    # 취소선 - ~~...~~\n473\t    text = re.sub(r\"~~([^~\\[\\]]+?)~~\", r\"<del>\\1</del>\", text)\n474\t\n475\t    # 이미지 - ![대체](주소) (먼저 처리)\n476\t    text = re.sub(r\"!\\[([^\\]]*)\\]\\(([^)]+)\\)\", r'<img src=\"\\2\" alt=\"\\1\">', text)\n477\t\n478\t    # 링크 - [텍스트](주소)\n479\t    text = re.sub(r\"\\[([^\\]]+)\\]\\(([^)]+)\\)\", r'<a href=\"\\2\">\\1</a>', text)\n480\t\n481\t    # 이스케이프 플레이스홀더 복원\n482\t    text = _restore_backslash_escapes(text)\n483\t\n484\t    return text\n485\t"}]},"uuid":"2e734bae-5a52-4f25-aa94-3fc27e2083d1","timestamp":"2026-08-23T07:38:36.403Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/pal-x-92/s3/md.py","content":"\"\"\"마크다운 렌더러.\"\"\"\n\nimport re\nfrom typing import List, Tuple\n\n\nclass MarkdownError(Exception):\n    \"\"\"마크다운 렌더링 오류.\"\"\"\n    pass\n\n\ndef render(text: str) -> str:\n    \"\"\"마크다운 텍스트를 HTML로 렌더링한다.\n\n    Args:\n        text: 마크다운 문자열\n\n    Returns:\n        HTML 문자열 (블록마다 한 줄, 끝에 개행 하나)\n\n    Raises:\n        MarkdownError: 잘못된 입력\n    \"\"\"\n    if not text:\n        return \"\"\n\n    # 규칙 24: \\r\\n 을 \\n 과 같게 다룬다\n    text = text.replace(\"\\r\\n\", \"\\n\")\n\n    # 코드 펜스 검증\n    _validate_code_fences(text)\n\n    # 블록 단위로 분해\n    blocks = _parse_blocks(text)\n\n    # 각 블록을 HTML로 변환\n    html_lines = []\n    for block_type, content in blocks:\n        html = _render_block(block_type, content)\n        if html:\n            html_lines.append(html)\n\n    if not html_lines:\n        return \"\"\n\n    return \"\\n\".join(html_lines) + \"\\n\"\n\n\ndef _validate_code_fences(text: str) -> None:\n    \"\"\"코드 펜스가 제대로 닫혀 있는지 확인.\"\"\"\n    lines = text.split(\"\\n\")\n    in_fence = False\n    for line in lines:\n        if line.strip().startswith(\"```\"):\n            in_fence = not in_fence\n    if in_fence:\n        raise MarkdownError(\"안 닫힌 코드 펜스\")\n\n\ndef _is_table_start(line: str) -> bool:\n    \"\"\"라인이 표의 헤더 줄인지 확인한다.\"\"\"\n    return \"|\" in line and line.strip().startswith(\"|\")\n\n\ndef _is_table_separator(line: str) -> bool:\n    \"\"\"라인이 표의 구분선인지 확인한다.\"\"\"\n    if not (\"|\" in line):\n        return False\n    # 파이프로 분리된 각 셀이 --- 패턴인지 확인\n    cells = line.split(\"|\")\n    for cell in cells:\n        cell = cell.strip()\n        if not cell:\n            continue\n        # --- 또는 :--  또는 --: 또는 :-: 등의 정렬 표시 확인\n        if not re.match(r\"^:?-+:?$\", cell):\n            return False\n    return True\n\n\ndef _parse_blocks(text: str) -> List[Tuple[str, str]]:\n    \"\"\"텍스트를 블록으로 분해한다.\"\"\"\n    lines = text.split(\"\\n\")\n    blocks = []\n    i = 0\n\n    while i < len(lines):\n        line = lines[i]\n\n        # 빈 줄 건너뛰기\n        if not line.strip():\n            i += 1\n            continue\n\n        # 코드 펜스 (``` 로 시작)\n        if line.strip().startswith(\"```\"):\n            fence_lines = [line]\n            i += 1\n            while i < len(lines):\n                fence_lines.append(lines[i])\n                if lines[i].strip().startswith(\"```\"):\n                    break\n                i += 1\n            blocks.append((\"code_fence\", \"\\n\".join(fence_lines)))\n            i += 1\n            continue\n\n        # 수평선\n        if re.match(r\"^(---+|\\*\\*\\*+|___+)$\", line.strip()):\n            blocks.append((\"hr\", \"\"))\n            i += 1\n            continue\n\n        # 헤딩\n        heading_match = re.match(r\"^(#{1,6})\\s+(.+?)(\\s*#+)?$\", line)\n        if heading_match:\n            level = len(heading_match.group(1))\n            content = heading_match.group(2)\n            blocks.append((\"heading\", f\"{level}|{content}\"))\n            i += 1\n            continue\n\n        # 표 (규칙 21-23)\n        if _is_table_start(line) and i + 1 < len(lines):\n            if _is_table_separator(lines[i + 1]):\n                # 테이블 파싱\n                table_lines = [line, lines[i + 1]]\n                i += 2\n                while i < len(lines) and lines[i].strip() and lines[i].startswith(\"|\"):\n                    table_lines.append(lines[i])\n                    i += 1\n                blocks.append((\"table\", \"\\n\".join(table_lines)))\n                continue\n\n        # 순서 있는 목록\n        if re.match(r\"^\\s*\\d+[.)]\\s+\", line):\n            list_lines = []\n            while i < len(lines) and (not lines[i].strip() or re.match(r\"^(\\s*(\\d+[.)]\\s+|  ))\", lines[i])):\n                if not lines[i].strip():\n                    break\n                list_lines.append(lines[i])\n                i += 1\n            blocks.append((\"ol\", \"\\n\".join(list_lines)))\n            continue\n\n        # 순서 없는 목록\n        if re.match(r\"^\\s*[-*+]\\s+\", line):\n            list_lines = []\n            while i < len(lines) and (not lines[i].strip() or re.match(r\"^(\\s*([-*+]\\s+|  ))\", lines[i])):\n                if not lines[i].strip():\n                    break\n                list_lines.append(lines[i])\n                i += 1\n            blocks.append((\"ul\", \"\\n\".join(list_lines)))\n            continue\n\n        # 인용문\n        if line.startswith(\">\"):\n            quote_lines = []\n            while i < len(lines) and (lines[i].startswith(\">\") or (not lines[i].strip() and i + 1 < len(lines) and lines[i + 1].startswith(\">\"))):\n                if lines[i].startswith(\">\"):\n                    quote_lines.append(lines[i][1:].lstrip() if len(lines[i]) > 1 else \"\")\n                else:\n                    quote_lines.append(\"\")\n                i += 1\n            blocks.append((\"blockquote\", \"\\n\".join(quote_lines)))\n            continue\n\n        # 일반 문단\n        para_lines = []\n        while i < len(lines) and lines[i].strip() and not re.match(r\"^(#{1,6}\\s+|---+|\\*\\*\\*+|___+|\\s*\\d+[.)]\\s+|\\s*[-*+]\\s+|>)\", lines[i]):\n            para_lines.append(lines[i])\n            i += 1\n\n        if para_lines:\n            blocks.append((\"paragraph\", \"\\n\".join(para_lines)))\n\n    return blocks\n\n\ndef _render_block(block_type: str, content: str) -> str:\n    \"\"\"블록을 HTML로 렌더링한다.\"\"\"\n    if block_type == \"heading\":\n        level, text = content.split(\"|\", 1)\n        level = int(level)\n        html_content = _render_inline(text)\n        return f\"<h{level}>{html_content}</h{level}>\"\n\n    elif block_type == \"paragraph\":\n        # 줄바꿈 처리\n        lines = content.split(\"\\n\")\n        rendered_lines = []\n        for line in lines:\n            html_content = _render_inline(line)\n            rendered_lines.append(html_content)\n\n        full_html = \"\\n\".join(rendered_lines)\n        # 줄 끝 공백 두 개를 <br>로\n        full_html = re.sub(r\"  \\n\", \"<br>\\n\", full_html)\n\n        return f\"<p>{full_html}</p>\"\n\n    elif block_type == \"hr\":\n        return \"<hr>\"\n\n    elif block_type == \"code_fence\":\n        lines = content.split(\"\\n\")\n        first_line = lines[0]\n\n        # 언어 추출\n        lang_match = re.match(r\"^```(\\w+)?\", first_line)\n        lang = lang_match.group(1) if lang_match and lang_match.group(1) else None\n\n        # 코드 내용 (첫 줄과 마지막 줄 제외)\n        code_lines = lines[1:-1] if len(lines) > 2 else []\n        code_content = \"\\n\".join(code_lines)\n\n        # HTML 이스케이프\n        code_content = _escape_html(code_content)\n\n        if lang:\n            return f'<pre><code class=\"language-{lang}\">{code_content}\\n</code></pre>'\n        else:\n            return f\"<pre><code>{code_content}\\n</code></pre>\"\n\n    elif block_type == \"ul\":\n        return _render_list(content, \"ul\")\n\n    elif block_type == \"ol\":\n        return _render_list(content, \"ol\")\n\n    elif block_type == \"blockquote\":\n        inner_html = render(content)\n        if inner_html.endswith(\"\\n\"):\n            inner_html = inner_html[:-1]\n        lines = inner_html.split(\"\\n\") if inner_html else []\n        result = \"<blockquote>\\n\" + \"\\n\".join(lines) + \"\\n</blockquote>\"\n        return result\n\n    elif block_type == \"table\":\n        return _render_table(content)\n\n    return \"\"\n\n\ndef _render_list(content: str, list_type: str) -> str:\n    \"\"\"목록을 HTML로 렌더링한다.\"\"\"\n    lines = content.split(\"\\n\")\n\n    # 목록 항목과 들여쓰기 수준 파싱\n    items = []\n    for line in lines:\n        if not line.strip():\n            continue\n\n        # 들여쓰기 수준 계산 (2칸 = 1 레벨)\n        indent = (len(line) - len(line.lstrip())) // 2\n\n        # 마크 제거\n        match = re.match(r\"^\\s*([-*+]|\\d+[.)])\\s+(.*)$\", line)\n        if match:\n            text = match.group(2)\n            items.append((indent, text))\n\n    if not items:\n        return f\"<{list_type}></{list_type}>\"\n\n    # 중첩 구조로 HTML 생성\n    return _build_nested_list(items, list_type, 0)\n\n\ndef _build_nested_list(items: List[Tuple[int, str]], list_type: str, target_indent: int) -> str:\n    \"\"\"중첩된 목록을 HTML로 구성한다.\"\"\"\n    if not items or items[0][0] < target_indent:\n        return \"\"\n\n    html_lines = [f\"<{list_type}>\"]\n    i = 0\n\n    while i < len(items):\n        indent, text = items[i]\n\n        if indent < target_indent:\n            break\n\n        if indent == target_indent:\n            html_content = _render_inline(text)\n\n            # 다음 항목이 중첩인지 확인\n            if i + 1 < len(items) and items[i + 1][0] > target_indent:\n                # 중첩된 목록이 있음\n                nested_items = []\n                j = i + 1\n                while j < len(items) and items[j][0] > target_indent:\n                    nested_items.append(items[j])\n                    j += 1\n\n                # 중첩 목록 생성 (같은 리스트 타입 사용)\n                nested_html = _build_nested_list(nested_items, list_type, target_indent + 1)\n\n                html_lines.append(f\"<li>{html_content}\")\n                html_lines.append(nested_html)\n                html_lines.append(\"</li>\")\n\n                i = j\n            else:\n                html_lines.append(f\"<li>{html_content}</li>\")\n                i += 1\n        else:\n            break\n\n    html_lines.append(f\"</{list_type}>\")\n    return \"\\n\".join(html_lines)\n\n\ndef _render_table(content: str) -> str:\n    \"\"\"표를 HTML로 렌더링한다 (규칙 21-23).\"\"\"\n    lines = content.split(\"\\n\")\n    if len(lines) < 2:\n        return \"\"\n\n    # 헤더 줄 파싱\n    header_cells = _parse_table_row(lines[0])\n    if not header_cells:\n        return \"\"\n\n    # 구분선 파싱 (정렬 정보 추출)\n    separator_cells = _parse_table_row(lines[1])\n    alignments = []\n    for sep in separator_cells:\n        alignments.append(_get_alignment(sep))\n\n    # HTML 생성 시작\n    html_lines = [\"<table>\", \"<thead>\", \"<tr>\"]\n\n    # 헤더 셀 렌더링\n    for i, cell in enumerate(header_cells):\n        html_content = _render_inline(cell)\n        alignment = alignments[i] if i < len(alignments) else None\n        if alignment:\n            html_lines.append(f'<th style=\"text-align:{alignment}\">{html_content}</th>')\n        else:\n            html_lines.append(f\"<th>{html_content}</th>\")\n\n    html_lines.extend([\"</tr>\", \"</thead>\", \"<tbody>\"])\n\n    # 본문 줄 렌더링\n    for line in lines[2:]:\n        if not line.strip():\n            continue\n        body_cells = _parse_table_row(line)\n        html_lines.append(\"<tr>\")\n        for i, cell in enumerate(body_cells):\n            html_content = _render_inline(cell)\n            alignment = alignments[i] if i < len(alignments) else None\n            if alignment:\n                html_lines.append(f'<td style=\"text-align:{alignment}\">{html_content}</td>')\n            else:\n                html_lines.append(f\"<td>{html_content}</td>\")\n        html_lines.append(\"</tr>\")\n\n    html_lines.extend([\"</tbody>\", \"</table>\"])\n\n    return \"\\n\".join(html_lines)\n\n\ndef _parse_table_row(line: str) -> List[str]:\n    \"\"\"표의 한 줄을 파싱하여 셀 목록을 반환한다.\"\"\"\n    # 양쪽 파이프 제거\n    line = line.strip()\n    if line.startswith(\"|\"):\n        line = line[1:]\n    if line.endswith(\"|\"):\n        line = line[:-1]\n\n    # 파이프로 분리하고 공백 제거\n    cells = [cell.strip() for cell in line.split(\"|\")]\n    return cells\n\n\ndef _get_alignment(sep_cell: str) -> str:\n    \"\"\"구분선 셀에서 정렬을 추출한다.\"\"\"\n    sep_cell = sep_cell.strip()\n\n    if sep_cell.startswith(\":\") and sep_cell.endswith(\":\"):\n        return \"center\"\n    elif sep_cell.endswith(\":\"):\n        return \"right\"\n    elif sep_cell.startswith(\":\"):\n        return \"left\"\n\n    return \"\"\n\n\ndef _render_inline(text: str) -> str:\n    \"\"\"인라인 요소를 렌더링한다.\"\"\"\n    # 역슬래시 이스케이프 (모든 것보다 먼저)\n    text = _handle_backslash_escapes(text)\n\n    # HTML 이스케이프\n    text = _escape_html(text)\n\n    # 코드 스팬 (중요: 다른 마크업보다 먼저)\n    text = _render_code_span(text)\n\n    # 강조 및 기타 인라인 마크업\n    text = _render_emphasis(text)\n\n    return text\n\n\ndef _handle_backslash_escapes(text: str) -> str:\n    \"\"\"역슬래시 이스케이프를 처리한다.\"\"\"\n    # 이스케이프된 문자들을 플레이스홀더로 변환\n    escapes = {\n        r\"\\*\": \"\\x00STAR\\x00\",\n        r\"\\_\": \"\\x00USCORE\\x00\",\n        r\"\\#\": \"\\x00HASH\\x00\",\n        r\"\\-\": \"\\x00DASH\\x00\",\n        r\"\\~\": \"\\x00TILDE\\x00\",\n        r\"\\[\": \"\\x00LBRACK\\x00\",\n        r\"\\!\": \"\\x00EXCL\\x00\",\n        r\"\\\\\": \"\\x00BSLASH\\x00\",\n    }\n    for escaped, placeholder in escapes.items():\n        text = text.replace(escaped, placeholder)\n    return text\n\n\ndef _restore_backslash_escapes(text: str) -> str:\n    \"\"\"이스케이프 플레이스홀더를 원래 문자로 복원한다.\"\"\"\n    restores = {\n        \"\\x00STAR\\x00\": \"*\",\n        \"\\x00USCORE\\x00\": \"_\",\n        \"\\x00HASH\\x00\": \"#\",\n        \"\\x00DASH\\x00\": \"-\",\n        \"\\x00TILDE\\x00\": \"~\",\n        \"\\x00LBRACK\\x00\": \"[\",\n        \"\\x00EXCL\\x00\": \"!\",\n        \"\\x00BSLASH\\x00\": \"\\\\\",\n    }\n    for placeholder, char in restores.items():\n        text = text.replace(placeholder, char)\n    return text\n\n\ndef _escape_html(text: str) -> str:\n    \"\"\"HTML 특수 문자를 이스케이프한다.\"\"\"\n    text = text.replace(\"&\", \"&amp;\")\n    text = text.replace(\"<\", \"&lt;\")\n    text = text.replace(\">\", \"&gt;\")\n    return text\n\n\ndef _render_code_span(text: str) -> str:\n    \"\"\"코드 스팬을 렌더링한다 (백틱).\"\"\"\n    # 백틱 안의 내용은 이미 이스케이프됨\n    pattern = r\"`([^`]+)`\"\n    return re.sub(pattern, r\"<code>\\1</code>\", text)\n\n\ndef _render_emphasis(text: str) -> str:\n    \"\"\"강조, 기울임, 취소선을 렌더링한다.\"\"\"\n    # 강조 (굵게) - **...** 먼저 (non-bracket, non-star)\n    text = re.sub(r\"\\*\\*([^*\\[\\]]+?)\\*\\*\", r\"<strong>\\1</strong>\", text)\n    text = re.sub(r\"__([^_\\[\\]]+?)__\", r\"<strong>\\1</strong>\", text)\n\n    # 기울임 - *...* 또는 _..._\n    text = re.sub(r\"\\*([^*\\[\\]]+?)\\*\", r\"<em>\\1</em>\", text)\n    text = re.sub(r\"_([^_\\[\\]]+?)_\", r\"<em>\\1</em>\", text)\n\n    # 취소선 - ~~...~~\n    text = re.sub(r\"~~([^~\\[\\]]+?)~~\", r\"<del>\\1</del>\", text)\n\n    # 이미지 - ![대체](주소) (먼저 처리)\n    text = re.sub(r\"!\\[([^\\]]*)\\]\\(([^)]+)\\)\", r'<img src=\"\\2\" alt=\"\\1\">', text)\n\n    # 링크 - [텍스트](주소)\n    text = re.sub(r\"\\[([^\\]]+)\\]\\(([^)]+)\\)\", r'<a href=\"\\2\">\\1</a>', text)\n\n    # 이스케이프 플레이스홀더 복원\n    text = _restore_backslash_escapes(text)\n\n    return text\n","numLines":485,"startLine":1,"totalLines":485}},"sourceToolAssistantUUID":"5feb46ce-8634-4b01-ad78-a1