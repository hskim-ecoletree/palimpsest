Pivot count\"\"\"\n    csv = \"category,status\\nA,pass\\nA,fail\\nA,pass\\nB,pass\\nB,fail\\nB,fail\\nB,fail\"\n    t = normalize(csv)\n    result = pivot_count(t, \"category\", \"status\")\n\n    assert result[\"A\"][\"pass\"] == 2\n    assert result[\"A\"][\"fail\"] == 1\n    assert result[\"B\"][\"pass\"] == 1\n    assert result[\"B\"][\"fail\"] == 3\n\n    # With missing values\n    csv = \"category,status\\nA,pass\\nA,\\nB,fail\"\n    t = normalize(csv)\n    result = pivot_count(t, \"category\", \"status\")\n    assert result[\"A\"][None] == 1\n    assert result[\"A\"][\"pass\"] == 1\n    assert result[\"B\"][\"fail\"] == 1\n\n    # Error on missing column\n    try:\n        pivot_count(t, \"nonexistent\", \"status\")\n        assert False, \"Should raise NormError\"\n    except NormError:\n        pass\n\n    print(\"✓ Pivot count\")\n\n\ndef test_large_input_round_trip():\n    \"\"\"Test rule 28: Round-trip with large input (10000 rows)\"\"\"\n    # Create large CSV with 10000 rows\n    lines = [\"a,b,c\"]\n    for i in range(10000):\n        lines.append(f\"{i},{i*2},{i*3}\")\n\n    csv_large = \"\\n\".join(lines)\n    t1 = normalize(csv_large)\n\n    # Verify size\n    assert len(t1[\"rows\"]) == 10000\n\n    # Test round-trip\n    rendered = render(t1)\n    t2 = normalize(rendered)\n\n    assert t1 == t2\n    print(\"✓ Large input round-trip (10000 rows)\")\n\n\nif __name__ == \"__main__\":"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":8,"cache_creation_input_tokens":887,"cache_read_input_tokens":50829,"output_tokens":1176,"output_tokens_details":{"thinking_tokens":47},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":887},"inference_geo":"not_available","iterations":[{"input_tokens":8,"output_tokens":1176,"cache_read_input_tokens":50829,"cache_creation_input_token