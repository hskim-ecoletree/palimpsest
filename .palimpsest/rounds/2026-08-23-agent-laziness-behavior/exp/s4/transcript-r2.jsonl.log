{"parentUuid":"4444fa03-b620-45a6-802d-b3e10ae48955","isSidechain":true,"promptId":"83207ea1-32c4-4456-9dc8-743dc2b1bf46","agentId":"a77f0177a3ec40f91","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MZQuKmc5BLgXY9UkZvLstm","type":"tool_result","content":"1\timport re\n2\tfrom typing import List, Tuple, Optional\n3\t\n4\t\n5\tclass MarkdownError(Exception):\n6\t    \"\"\"Exception raised for invalid markdown.\"\"\"\n7\t    pass\n8\t\n9\t\n10\tdef render(text: str) -> str:\n11\t    \"\"\"Render markdown text to HTML string.\"\"\"\n12\t    if not text:\n13\t        return \"\"\n14\t\n15\t    # Split into lines\n16\t    lines = text.split('\\n')\n17\t\n18\t    # Process blocks\n19\t    html_blocks = []\n20\t    i = 0\n21\t\n22\t    while i < len(lines):\n23\t        line = lines[i]\n24\t\n25\t        # Check for code fence start\n26\t        if line.strip().startswith('```'):\n27\t            # Process code block\n28\t            result, next_i = _process_code_fence(lines, i)\n29\t            html_blocks.append(result)\n30\t            i = next_i\n31\t            continue\n32\t\n33\t        # Check for heading\n34\t        if line.startswith('#'):\n35\t            level, content = _parse_heading(line)\n36\t            if level:\n37\t                html_blocks.append(_render_heading(level, content))\n38\t                i += 1\n39\t                continue\n40\t\n41\t        # Check for horizontal line\n42\t        if _is_horizontal_line(line):\n43\t            html_blocks.append('<hr>')\n44\t            i += 1\n45\t            continue\n46\t\n47\t        # Check for blockquote\n48\t        if line.startswith('>'):\n49\t            result, next_i = _process_blockquote(lines, i)\n50\t            html_blocks.append(result)\n51\t            i = next_i\n52\t            continue\n53\t\n54\t        # Check for list (ordered or unordered)\n55\t        if _is_list_start(line):\n56\t            result, next_i = _process_list(lines, i)\n57\t            html_blocks.append(result)\n58\t            i = next_i\n59\t            continue\n60\t\n61\t        # Check for empty line\n62\t        if not line.strip():\n63\t            i += 1\n64\t            continue\n65\t\n66\t        # Regular paragraph\n67\t        html_blocks.append('<p>' + _render_inline(line) + '</p>')\n68\t        i += 1\n69\t\n70\t    if not html_blocks:\n71\t        return \"\"\n72\t\n73\t    return '\\n'.join(html_blocks) + '\\n'\n74\t\n75\t\n76\tdef _is_horizontal_line(line: str) -> bool:\n77\t    \"\"\"Check if line is a horizontal line.\"\"\"\n78\t    stripped = line.strip()\n79\t    return (stripped == '---' or stripped == '***' or stripped == '___')\n80\t\n81\t\n82\tdef _parse_heading(line: str) -> Tuple[Optional[int], str]:\n83\t    \"\"\"Parse heading level and content. Returns (level, content) or (None, '') if not a heading.\"\"\"\n84\t    match = re.match(r'^(#{1,6})\\s+(.*)$', line)\n85\t    if not match:\n86\t        return None, ''\n87\t\n88\t    level = len(match.group(1))\n89\t    content = match.group(2)\n90\t\n91\t    # Remove closing # characters\n92\t    content = re.sub(r'\\s*#+\\s*$', '', content)\n93\t\n94\t    return level, content\n95\t\n96\t\n97\tdef _render_heading(level: int, content: str) -> str:\n98\t    \"\"\"Render heading HTML.\"\"\"\n99\t    rendered = _render_inline(content)\n100\t    return f'<h{level}>{rendered}</h{level}>'\n101\t\n102\t\n103\tdef _is_list_start(line: str) -> bool:\n104\t    \"\"\"Check if line starts a list.\"\"\"\n105\t    stripped = line.lstrip()\n106\t    # Unordered list\n107\t    if re.match(r'^[-*+]\\s', stripped):\n108\t        return True\n109\t    # Ordered list\n110\t    if re.match(r'^\\d+[.)]\\s', stripped):\n111\t        return True\n112\t    return False\n113\t\n114\t\n115\tdef _get_list_indent(line: str) -> int:\n116\t    \"\"\"Get the indentation level of a list item (number of leading spaces).\"\"\"\n117\t    return len(line) - len(line.lstrip())\n118\t\n119\t\n120\tdef _is_list_item(line: str) -> bool:\n121\t    \"\"\"Check if line is a list item (unordered or ordered).\"\"\"\n122\t    stripped = line.lstrip()\n123\t    if re.match(r'^[-*+]\\s', stripped):\n124\t        return True\n125\t    if re.match(r'^\\d+[.)]\\s', stripped):\n126\t        return True\n127\t    return False\n128\t\n129\t\n130\tdef _get_list_type(line: str) -> Optional[str]:\n131\t    \"\"\"Get list type: 'ul', 'ol', or None.\"\"\"\n132\t    stripped = line.lstrip()\n133\t    if re.match(r'^[-*+]\\s', stripped):\n134\t        return 'ul'\n135\t    if re.match(r'^\\d+[.)]\\s', stripped):\n136\t        return 'ol'\n137\t    return None\n138\t\n139\t\n140\tdef _extract_list_content(line: str) -> str:\n141\t    \"\"\"Extract content from list item, removing the marker.\"\"\"\n142\t    stripped = line.lstrip()\n143\t    # Remove unordered marker\n144\t    match = re.match(r'^[-*+]\\s+(.*)$', stripped)\n145\t    if match:\n146\t        return match.group(1)\n147\t    # Remove ordered marker\n148\t    match = re.match(r'^\\d+[.)]\\s+(.*)$', stripped)\n149\t    if match:\n150\t        return match.group(1)\n151\t    return stripped\n152\t\n153\t\n154\tdef _process_list(lines: List[str], start_idx: int) -> Tuple[str, int]:\n155\t    \"\"\"Process a list block (unordered or ordered, potentially nested).\"\"\"\n156\t    list_type = _get_list_type(lines[start_idx])\n157\t    if not list_type:\n158\t        return '<p>' + _render_inline(lines[start_idx]) + '</p>', start_idx + 1\n159\t\n160\t    # Get the base indentation level\n161\t    base_indent = _get_list_indent(lines[start_idx])\n162\t\n163\t    html_parts = [f'<{list_type}>']\n164\t    i = start_idx\n165\t\n166\t    while i < len(lines):\n167\t        line = lines[i]\n168\t\n169\t        # Empty line ends list\n170\t        if not line.strip():\n171\t            break\n172\t\n173\t        # Check if this is still a list item\n174\t        if not _is_list_item(line):\n175\t            break\n176\t\n177\t        current_type = _get_list_type(line)\n178\t        current_indent = _get_list_indent(line)\n179\t\n180\t        # Type change ends current list\n181\t        if current_type != list_type:\n182\t            break\n183\t\n184\t        # If indentation is higher than base, skip until we're back at base level or find nested content\n185\t        if current_indent > base_indent:\n186\t            break\n187\t\n188\t        # Process item at base level\n189\t        content = _extract_list_content(line)\n190\t\n191\t        # Look ahead for nested items\n192\t        if i + 1 < len(lines):\n193\t            next_line = lines[i + 1]\n194\t            next_indent = _get_list_indent(next_line)\n195\t\n196\t            if _is_list_item(next_line) and next_indent > current_indent:\n197\t                # This item will have nested content\n198\t                html_parts.append(f'<li>{_render_inline(content)}')\n199\t\n200\t                # Process nested list\n201\t                nested_html, next_i = _process_list(lines, i + 1)\n202\t                html_parts.append(nested_html)\n203\t                html_parts.append('</li>')\n204\t                i = next_i\n205\t            else:\n206\t                html_parts.append(f'<li>{_render_inline(content)}</li>')\n207\t                i += 1\n208\t        else:\n209\t            html_parts.append(f'<li>{_render_inline(content)}</li>')\n210\t            i += 1\n211\t\n212\t    html_parts.append(f'</{list_type}>')\n213\t    return '\\n'.join(html_parts), i\n214\t\n215\t\n216\tdef _process_blockquote(lines: List[str], start_idx: int) -> Tuple[str, int]:\n217\t    \"\"\"Process a blockquote block.\"\"\"\n218\t    blockquote_lines = []\n219\t    i = start_idx\n220\t\n221\t    while i < len(lines):\n222\t        line = lines[i]\n223\t\n224\t        if not line.startswith('>'):\n225\t            break\n226\t\n227\t        # Remove the '> ' prefix\n228\t        content = line[1:]\n229\t        if content.startswith(' '):\n230\t            content = content[1:]\n231\t\n232\t        blockquote_lines.append(content)\n233\t        i += 1\n234\t\n235\t    # Render the blockquote content as markdown\n236\t    blockquote_text = '\\n'.join(blockquote_lines)\n237\t    inner_html = render(blockquote_text).rstrip('\\n')\n238\t\n239\t    # Split inner_html back into lines for blockquote format\n240\t    inner_lines = inner_html.split('\\n')\n241\t\n242\t    html_parts = ['<blockquote>']\n243\t    html_parts.extend(inner_lines)\n244\t    html_parts.append('</blockquote>')\n245\t\n246\t    return '\\n'.join(html_parts), i\n247\t\n248\t\n249\tdef _process_code_fence(lines: List[str], start_idx: int) -> Tuple[str, int]:\n250\t    \"\"\"Process a code fence block.\"\"\"\n251\t    fence_line = lines[start_idx].strip()\n252\t\n253\t    # Extract language (if any)\n254\t    match = re.match(r'^```(\\w*)$', fence_line)\n255\t    if not match:\n256\t        raise MarkdownError(f\"Invalid code fence: {fence_line}\")\n257\t\n258\t    language = match.group(1) if match.group(1) else None\n259\t\n260\t    # Find closing fence\n261\t    code_lines = []\n262\t    i = start_idx + 1\n263\t\n264\t    while i < len(lines):\n265\t        if lines[i].strip() == '```':\n266\t            # Found closing fence\n267\t            code_content = '\\n'.join(code_lines)\n268\t            escaped_content = _escape_html(code_content)\n269\t\n270\t            if language:\n271\t                return f'<pre><code class=\"language-{language}\">{escaped_content}\\n</code></pre>', i + 1\n272\t            else:\n273\t                return f'<pre><code>{escaped_content}\\n</code></pre>', i + 1\n274\t\n275\t        code_lines.append(lines[i])\n276\t        i += 1\n277\t\n278\t    # No closing fence found\n279\t    raise MarkdownError(\"Unclosed code fence\")\n280\t\n281\t\n282\tdef _render_inline(text: str) -> str:\n283\t    \"\"\"Render inline markdown (emphasis, links, etc.).\"\"\"\n284\t    # Process in order: escape HTML, handle escapes, then inline formatting\n285\t\n286\t    # Handle backslash escapes first - mark them to protect from further processing\n287\t    text = _handle_backslash_escapes(text)\n288\t\n289\t    # Escape HTML entities (but not in code spans or already escaped text)\n290\t    text = _escape_html_except_protected(text)\n291\t\n292\t    # Process line breaks (two spaces at end)\n293\t    text = _process_line_breaks(text)\n294\t\n295\t    # Process inline elements - ORDER MATTERS\n296\t    text = _process_code_spans(text)\n297\t    text = _process_images(text)  # MUST come before links!\n298\t    text = _process_links(text)\n299\t    text = _process_strong(text)\n300\t    text = _process_em(text)\n301\t    text = _process_strikethrough(text)\n302\t\n303\t    # Restore escaped characters\n304\t    text = _restore_escaped_chars(text)\n305\t\n306\t    return text\n307\t\n308\t\n309\tdef _handle_backslash_escapes(text: str) -> str:\n310\t    r\"\"\"Handle backslash escapes like \\* \\# etc.\"\"\"\n311\t    # Replace \\X with a placeholder that won't be affected by markdown processing\n312\t    result = []\n313\t    i = 0\n314\t    while i < len(text):\n315\t        if i < len(text) - 1 and text[i] == '\\\\':\n316\t            next_char = text[i + 1]\n317\t            # Only escape special markdown chars\n318\t            if next_char in '*_#[]()!`~<>&\\\\':\n319\t                # Use a special marker for escaped chars - format: \\x00\\x01{charcode}\\x01\\x00\n320\t                # This format avoids interference with markdown patterns\n321\t                result.append(f'\\x00\\x01{ord(next_char):03d}\\x01\\x00')\n322\t                i += 2\n323\t            else:\n324\t                result.append(text[i])\n325\t                i += 1\n326\t        else:\n327\t            result.append(text[i])\n328\t            i += 1\n329\t    return ''.join(result)\n330\t\n331\t\n332\tdef _restore_escaped_chars(text: str) -> str:\n333\t    \"\"\"Restore escaped characters back to their original form.\"\"\"\n334\t    import re\n335\t    def replace_escaped(match):\n336\t        char_code = int(match.group(1))\n337\t        return chr(char_code)\n338\t    return re.sub(r'\\x00\\x01(\\d{3})\\x01\\x00', replace_escaped, text)\n339\t\n340\t\n341\tdef _escape_html_except_protected(text: str) -> str:\n342\t    \"\"\"Escape HTML entities, except for protected escaped chars.\"\"\"\n343\t    # Temporarily replace protected chars\n344\t    text = text.replace('&', '\\x01AMP\\x01')\n345\t    text = text.replace('<', '\\x01LT\\x01')\n346\t    text = text.replace('>', '\\x01GT\\x01')\n347\t\n348\t    # Escape to entities\n349\t    text = text.replace('\\x01AMP\\x01', '&amp;')\n350\t    text = text.replace('\\x01LT\\x01', '&lt;')\n351\t    text = text.replace('\\x01GT\\x01', '&gt;')\n352\t\n353\t    return text\n354\t\n355\t\n356\tdef _escape_html(text: str) -> str:\n357\t    \"\"\"Escape HTML special characters.\"\"\"\n358\t    text = text.replace('&', '&amp;')\n359\t    text = text.replace('<', '&lt;')\n360\t    text = text.replace('>', '&gt;')\n361\t    return text\n362\t\n363\t\n364\tdef _process_line_breaks(text: str) -> str:\n365\t    \"\"\"Process line breaks (two spaces at end of line).\"\"\"\n366\t    # Two spaces at end of line become <br>\n367\t    return re.sub(r'  +$', '<br>', text, flags=re.MULTILINE)\n368\t\n369\t\n370\tdef _process_code_spans(text: str) -> str:\n371\t    \"\"\"Process inline code spans with backticks.\"\"\"\n372\t    # Match backtick code spans\n373\t    def replace_code(match):\n374\t        code = match.group(1)\n375\t        # HTML is already escaped by _escape_html_except_protected, don't escape again\n376\t        return f'<code>{code}</code>'\n377\t\n378\t    # Use non-greedy matching for code spans\n379\t    text = re.sub(r'`([^`]+)`', replace_code, text)\n380\t    return text\n381\t\n382\t\n383\tdef _process_strong(text: str) -> str:\n384\t    \"\"\"Process **strong** text.\"\"\"\n385\t    def replace_strong(match):\n386\t        content = match.group(1)\n387\t        # Don't process nested markdown, just preserve content\n388\t        return f'<strong>{content}</strong>'\n389\t\n390\t    # Handle escaped markers\n391\t    text = re.sub(r'\\*\\*(.+?)\\*\\*', replace_strong, text)\n392\t    return text\n393\t\n394\t\n395\tdef _process_em(text: str) -> str:\n396\t    \"\"\"Process *emphasis* and _emphasis_ text.\"\"\"\n397\t    def replace_em(match):\n398\t        content = match.group(1)\n399\t        # Don't process nested markdown, just preserve content\n400\t        return f'<em>{content}</em>'\n401\t\n402\t    # Match *text* but not **text**\n403\t    text = re.sub(r'(?<!\\*)\\*([^*]+)\\*(?!\\*)', replace_em, text)\n404\t    # Match _text_ but not __text__\n405\t    text = re.sub(r'(?<!_)_([^_]+)_(?!_)', replace_em, text)\n406\t\n407\t    return text\n408\t\n409\t\n410\tdef _process_strikethrough(text: str) -> str:\n411\t    \"\"\"Process ~~strikethrough~~ text.\"\"\"\n412\t    def replace_strike(match):\n413\t        content = match.group(1)\n414\t        # Don't process nested markdown, just preserve content\n415\t        return f'<del>{content}</del>'\n416\t\n417\t    text = re.sub(r'~~(.+?)~~', replace_strike, text)\n418\t    return text\n419\t\n420\t\n421\tdef _process_links(text: str) -> str:\n422\t    \"\"\"Process [text](url) links.\"\"\"\n423\t    def replace_link(match):\n424\t        link_text = match.group(1)\n425\t        url = match.group(2)\n426\t        # Preserve the link text as-is (already escaped)\n427\t        return f'<a href=\"{url}\">{link_text}</a>'\n428\t\n429\t    # Match [text](url)\n430\t    text = re.sub(r'\\[([^\\]]+)\\]\\(([^)]+)\\)', replace_link, text)\n431\t    return text\n432\t\n433\t\n434\tdef _process_images(text: str) -> str:\n435\t    \"\"\"Process ![alt](url) images.\"\"\"\n436\t    def replace_image(match):\n437\t        alt = match.group(1)\n438\t        url = match.group(2)\n439\t        return f'<img src=\"{url}\" alt=\"{alt}\">'\n440\t\n441\t    # Match