\n</blockquote>\\n\"),\n    (\"Rule 14a: Code fence\", \"```\\n코드\\n```\", \"<pre><code>코드\\n</code></pre>\\n\"),\n    (\"Rule 14b: Language\", \"```py\\nx\\n```\", \"<pre><code class=\\\"language-py\\\">x\\n</code></pre>\\n\"),\n    (\"Rule 15: HTML escape\", \"<tag>\", \"<p>&lt;tag&gt;</p>\\n\"),\n    (\"Rule 16: Backslash\", r\"\\*글\\*\", \"<p>*글*</p>\\n\"),\n    (\"Rule 17: Line break\", \"line1  \\nline2\", \"<p>line1<br>\\nline2</p>\\n\"),\n    (\"Rule 18: Empty line\", \"line1\\n\\nline2\", \"<p>line1</p>\\n<p>line2</p>\\n\"),\n    (\"Rule 20: Close heading\", \"## 제목 ##\", \"<h2>제목</h2>\\n\"),\n    (\"Rule 24: CRLF\", \"line1\\r\\nline2\", \"<p>line1\\nline2</p>\\n\"),\n]\n\npassed = 0\nfailed = 0\n\nfor name, input_text, expected in test_cases:\n    result = render(input_text)\n    if result == expected:\n        print(f\"✓ {name}\")\n        passed += 1\n    else:\n        print(f\"✗ {name}\")\n        print(f\"  Expected: {repr(expected[:50])}\")\n        print(f\"  Got:      {repr(result[:50])}\")\n        failed += 1\n\n# Error handling\ntry:\n    render(\"```\\ncode\")\n    print(\"✗ Unclosed fence error\")\n    failed += 1\nexcept MarkdownError:\n    print(\"✓ Unclosed fence error\")\n    passed += 1\n\n# Empty input\nif render(\"\") == \"\":\n    print(\"✓ Empty input\")\n    passed += 1\nelse:\n    print(\"✗ Empty input\")\n    failed += 1\n\n# Tables\nprint(\"\\n--- Table Tests ---\")\ntable_tests = [\n    (\"Table basic\", \"| h1 | h2 |\\n| --- | --- |\\n| c1 | c2 |\", \n     lambda r: \"<table>\" in r and \"<thead>\" in r and \"<tbody>\" in r),\n    (\"Table alignment\", \"| L | C | R |\\n| :--- | :-: | ---: |\\n| a | b | c |\",\n     lambda r: 'text-align:left' in r and 'text-align:center' in r and 'text-align:right' in r),\n    (\"Table inline\", \"| **b** | *i* |\\n| --- | --- |\\n| x | y |\",\n     lambda r: \"<strong>b</strong>\" in r and \"<em>i</em>\" in r),\n]\n\nfor name, input_text, check in table_tests:\n    result = render(input_text)