dered list -\", \"- 항목\\n\", \"<ul>\\n<li>항목</li>\\n</ul>\\n\")\ntest(\"Unordered list *\", \"* 항목\\n\", \"<ul>\\n<li>항목</li>\\n</ul>\\n\")\ntest(\"Unordered list +\", \"+ 항목\\n\", \"<ul>\\n<li>항목</li>\\n</ul>\\n\")\ntest(\"Ordered list 1.\", \"1. 항목\\n\", \"<ol>\\n<li>항목</li>\\n</ol>\\n\")\ntest(\"Ordered list 1)\", \"1) 항목\\n\", \"<ol>\\n<li>항목</li>\\n</ol>\\n\")\ntest(\"Nested list\", \"- 항목1\\n  - 항목2\\n\", \"<ul>\\n<li>항목1\\n<ul>\\n<li>항목2</li>\\n</ul>\\n</li>\\n</ul>\\n\")\n\nprint(\"\\n7. BLOCKQUOTES (Rule 13)\")\ntest(\"Simple blockquote\", \"> 글\\n\", \"<blockquote>\\n<p>글</p>\\n</blockquote>\\n\")\ntest(\"Blockquote with formatting\", \"> **bold** text\\n\", \"<blockquote>\\n<p><strong>bold</strong> text</p>\\n</blockquote>\\n\")\n\nprint(\"\\n8. CODE BLOCKS (Rule 14)\")\ntest(\"Code fence\", \"```\\ncode\\n```\\n\", \"<pre><code>code\\n</code></pre>\\n\")\ntest(\"Code fence with language\", \"```python\\ncode\\n```\\n\", '<pre><code class=\"language-python\">code\\n</code></pre>\\n')\n\nprint(\"\\n9. ESCAPING (Rule 15, 16)\")\ntest(\"HTML escape in code\", \"`<>`\\n\", \"<p><code>&lt;&gt;</code></p>\\n\")\ntest(\"HTML escape in fence\", \"```\\n<>\\n```\\n\", \"<pre><code>&lt;&gt;\\n</code></pre>\\n\")\ntest(\"Backslash escape *\", r\"\\*\" + \"\\n\", \"<p>*</p>\\n\")\ntest(\"Backslash escape #\", r\"\\#\" + \"\\n\", \"<p>#</p>\\n\")\ntest(\"Backslash escape [\", r\"\\[\" + \"\\n\", \"<p>[</p>\\n\")\n\nprint(\"\\n10. LINE BREAKS (Rule 17)\")\ntest(\"Line break with spaces\", \"line1  \\nline2\\n\", \"<p>line1<br>\\nline2</p>\\n\")\n\nprint(\"\\n11. PARAGRAPH SEPARATION (Rule 18)\")\ntest(\"Empty line breaks paragraphs\", \"a\\n\\nb\\n\", \"<p>a</p>\\n<p>b</p>\\n\")\ntest(\"Three paragraphs\", \"a\\n\\nb\\n\\nc\\n\", \"<p>a</p>\\n<p>b</p>\\n<p>c</p>\\n\")\n\nprint(\"\\n12. CODE FENCE VALIDATION (Rule 19)\")\ntest_error(\"Unclosed fence error\", \"```\\ncode\\n\", MarkdownError)\n\nprint(\"\\n13. HEADING CLOSING # (Rule 20)\")\ntest(\"Closing # removed\", \