old</strong></th>\\n</tr>\\n</thead>\\n<tbody>\\n<tr>\\n<td><code>code</code></td>\\n</tr>\\n</tbody>\\n</table>\\n\")\n\nprint(\"\\n15. LINE ENDING HANDLING (Rule 24)\")\ntest(\"CRLF normalization\", \"text\\r\\n\", \"<p>text</p>\\n\")\ntest(\"Mixed line endings with break\", \"a\\r\\n\\r\\nb\\n\", \"<p>a</p>\\n<p>b</p>\\n\")\n\nprint(\"\\n16. SPECIAL CASES\")\ntest(\"Empty input\", \"\", \"\")\ntest(\"Multiple spaces in text\", \"a   b\\n\", \"<p>a   b</p>\\n\")\n\nprint(\"\\n\" + \"=\" * 60)\nprint(f\"RESULTS: {tests_passed} passed, {tests_failed} failed\")\nprint(\"=\" * 60)\n\nif tests_failed == 0:\n    print(\"✓ ALL TESTS PASSED!\")\n    sys.exit(0)\nelse:\n    print(f\"✗ {tests_failed} test(s) failed\")\n    sys.exit(1)\n","numLines":140,"startLine":1,"totalLines":140}},"sourceToolAssistantUUID":"5cbb95db-2cd6-4c87-900c-dba99ac53f33","userType":"external","entrypoint":"cli","cwd":"/Users/incognito/dev/projects/palimpsest-agent-laziness","sessionId":"34d9dd87-316d-46cf-89ff-ac02b41e62ea","version":"2.1.241","gitBranch":"round/agent-laziness"}
